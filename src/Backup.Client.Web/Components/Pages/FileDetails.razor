@page "/files/{fileId:guid}"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.DTOs
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncProfileService ProfileService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IClipboardService ClipboardService
@inject ILogger<FileDetails> Logger

<PageTitle>@(fileMetadata != null ? fileMetadata.RelativePath : "Сведения о файле")</PageTitle>

<div class="page-header">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <div>
            <h1 class="page-title mono" style="font-size: 1.35rem;">@(fileMetadata?.RelativePath ?? "Сведения о файле")</h1>
            <p class="page-subtitle">История версий и восстановление</p>
        </div>
        <div>
            <a href="/files" class="btn btn-secondary btn-sm" style="text-decoration: none;">
                ← Назад к файлам
            </a>
        </div>
    </div>
</div>

@if (isLoading)
{
    <section class="panel-section">
        <p class="text-secondary">Загрузка сведений о файле и версиях...</p>
    </section>
}
else if (!string.IsNullOrEmpty(errorMessage) && fileMetadata == null)
{
    <section class="panel-section">
        <div class="alert alert-danger">
            <strong>Ошибка:</strong> @errorMessage
        </div>
        <div>
            <a href="/files" class="btn btn-secondary btn-sm" style="text-decoration: none; margin-top: 0.5rem;">
                Вернуться к списку файлов
            </a>
        </div>
    </section>
}
else if (fileMetadata != null)
{
    <!-- Общие сведения о файле -->
    <section class="panel-section">
        <div class="panel-header">
            <h2 class="panel-title">Свойства файла</h2>
            <div class="panel-actions">
                @if (fileMetadata.IsDeleted)
                {
                    <span class="status-badge badge-red">Удалён</span>
                }
                else
                {
                    <span class="status-badge badge-green">Активен</span>
                }
                <span class="status-badge badge-gray">@($"Текущая: v{fileMetadata.CurrentVersionNumber}")</span>
            </div>
        </div>

        <div class="kv-grid">
            <div class="kv-row">
                <span class="kv-key">Относительный путь:</span>
                <span class="kv-val mono">@fileMetadata.RelativePath</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Идентификатор (FileId):</span>
                <span class="kv-val mono">@fileMetadata.FileId</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Локальный путь:</span>
                <span class="kv-val mono">@(activeProfile != null ? Path.Combine(activeProfile.LocalRootPath, fileMetadata.RelativePath) : "—")</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Текущий размер:</span>
                <span class="kv-val mono">@(fileMetadata.CurrentSize.HasValue ? FormatSize(fileMetadata.CurrentSize.Value) : "—")</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Текущий SHA-256:</span>
                <span class="kv-val mono" title="@fileMetadata.CurrentSha256" style="display: flex; align-items: center; gap: 0.35rem;">
                    <span>@FormatTruncatedHash(fileMetadata.CurrentSha256)</span>
                    @if (!string.IsNullOrEmpty(fileMetadata.CurrentSha256))
                    {
                        <button class="btn btn-secondary btn-sm" style="padding: 1px 6px; font-size: 0.75rem;" title="Копировать полный SHA-256 (@fileMetadata.CurrentSha256)" @onclick="() => CopySha256Async(fileMetadata.CurrentSha256)">@(_copiedHashes.Contains(fileMetadata.CurrentSha256 ?? "") ? "Скопировано" : "📋")</button>
                    }
                </span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Последнее изменение (UTC):</span>
                <span class="kv-val mono">@fileMetadata.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")</span>
            </div>
        </div>
    </section>

    <!-- Результат операции восстановления -->
    @if (lastRestoreResult != null)
    {
        <section class="panel-section">
            <div class="result-box @(lastRestoreResult.Success ? "success" : "error")">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 600;">
                        @(lastRestoreResult.Success ? "Файл успешно восстановлен" : "Ошибка восстановления файла")
                    </span>
                    <button class="btn btn-secondary btn-sm" @onclick="() => lastRestoreResult = null">✕ Закрыть</button>
                </div>

                <div class="kv-grid">
                    <div class="kv-row">
                        <span class="kv-key">Статус:</span>
                        <span class="kv-val">
                            <span class="status-badge @(lastRestoreResult.Status == "SUCCESS" ? "badge-green" : "badge-amber")">
                                @(lastRestoreResult.Status == "SUCCESS" ? "Успешно" : lastRestoreResult.Status)
                            </span>
                        </span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Восстановленная версия:</span>
                        <span class="kv-val mono">@($"v{lastRestoreResult.SourceVersionNumber}")</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Новая версия в цепочке:</span>
                        <span class="kv-val mono">@(lastRestoreResult.NewCurrentVersionNumber.HasValue ? $"v{lastRestoreResult.NewCurrentVersionNumber.Value}" : "Совпадает с текущей")</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Локальный путь:</span>
                        <span class="kv-val mono">@lastRestoreResult.TargetLocalPath</span>
                    </div>

                    @if (!string.IsNullOrEmpty(lastRestoreResult.ErrorMessage))
                    {
                        <div class="kv-row">
                            <span class="kv-key">Примечание:</span>
                            <span class="kv-val text-warning">@lastRestoreResult.ErrorMessage</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- История версий файла -->
    <section class="panel-section">
        <div class="panel-header">
            <h2 class="panel-title">История версий</h2>
            <div class="panel-actions">
                <button class="btn btn-secondary btn-sm" @onclick="ReloadDataAsync" disabled="@isOperating">
                    Обновить
                </button>
            </div>
        </div>

        @if (versions.Count == 0)
        {
            <p class="text-secondary">История версий для данного файла отсутствует.</p>
        }
        else
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Версия</th>
                            <th>Размер</th>
                            <th>SHA-256</th>
                            <th>Создана (UTC)</th>
                            <th style="text-align: right;">Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ver in versions)
                        {
                            bool isCurrent = (ver.VersionNumber == fileMetadata.CurrentVersionNumber && !fileMetadata.IsDeleted);
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.45rem;">
                                        <span class="status-badge @(isCurrent ? "badge-green" : "badge-gray")">
                                            @($"v{ver.VersionNumber}")
                                        </span>
                                        @if (isCurrent)
                                        {
                                            <span style="font-size: 0.75rem; color: var(--success); font-weight: 500;">(текущая)</span>
                                        }
                                    </div>
                                </td>
                                <td class="mono">
                                    @FormatSize(ver.Size)
                                </td>
                                <td class="mono" title="@ver.Sha256" style="cursor: help; white-space: nowrap;">
                                    <span>@FormatTruncatedHash(ver.Sha256)</span>
                                    <button class="btn btn-secondary btn-sm" style="padding: 1px 6px; margin-left: 0.35rem; font-size: 0.75rem;" title="Копировать полный SHA-256 (@ver.Sha256)" @onclick="() => CopySha256Async(ver.Sha256)">@(_copiedHashes.Contains(ver.Sha256 ?? "") ? "Скопировано" : "📋")</button>
                                </td>
                                <td style="font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap;">
                                    @ver.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")
                                </td>
                                <td style="text-align: right;">
                                    @if (isCurrent)
                                    {
                                        <span class="text-secondary" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">Текущая</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary btn-sm"
                                                disabled="@isOperating"
                                                @onclick="() => RequestRestoreConfirmation(ver)">
                                            Восстановить
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<!-- Модальное окно подтверждения восстановления -->
@if (versionToRestore != null && fileMetadata != null)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3>@($"Восстановить версию v{versionToRestore.VersionNumber}?")</h3>
                <button class="btn btn-secondary btn-sm" @onclick="CancelRestoreConfirmation" disabled="@isOperating">✕</button>
            </div>

            <div class="modal-body">
                <p>
                    Локальный файл будет заменён содержимым выбранной версии.
                    Если файл содержит несинхронизированные изменения, они будут сохранены перед восстановлением.
                </p>

                <div class="kv-grid" style="margin-top: 0.5rem;">
                    <div class="kv-row">
                        <span class="kv-key">Файл:</span>
                        <span class="kv-val mono">@fileMetadata.RelativePath</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Версия:</span>
                        <span class="kv-val mono">@($"v{versionToRestore.VersionNumber}")</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Дата создания:</span>
                        <span class="kv-val mono">@versionToRestore.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss") UTC</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Размер:</span>
                        <span class="kv-val mono">@FormatSize(versionToRestore.Size)</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">SHA-256:</span>
                        <span class="kv-val mono">@FormatTruncatedHash(versionToRestore.Sha256)</span>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn btn-secondary btn-sm" @onclick="CancelRestoreConfirmation" disabled="@isOperating">
                    Отмена
                </button>
                <button class="btn btn-primary btn-sm" @onclick="ExecuteRestoreAsync" disabled="@isOperating">
                    @(isOperating ? "Восстановление..." : "Восстановить")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid FileId { get; set; }

    private SyncProfile? activeProfile;
    private FileMetadataDto? fileMetadata;
    private List<FileVersionDto> versions = new();
    private bool isLoading = true;
    private bool isOperating = false;
    private string? errorMessage;
    private RestoreExecutionResult? lastRestoreResult;
    private FileVersionDto? versionToRestore;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            activeProfile = await ProfileService.GetProfileAsync();
            if (activeProfile == null)
            {
                errorMessage = "Нет активного профиля синхронизации.";
                return;
            }

            var filesResp = await BackupService.GetFilesAsync(activeProfile.BackupSetId, includeDeleted: true);
            if (filesResp.Success && filesResp.Files != null)
            {
                fileMetadata = filesResp.Files.FirstOrDefault(f => f.FileId == FileId);
                if (fileMetadata == null)
                {
                    errorMessage = $"Файл с идентификатором {FileId} не найден в активном наборе.";
                    return;
                }
            }
            else
            {
                errorMessage = filesResp.ErrorMessage ?? "Не удалось загрузить данные файла со шлюза.";
                return;
            }

            var verResp = await BackupService.GetVersionsAsync(FileId);
            if (verResp.Success && verResp.Versions != null)
            {
                versions = verResp.Versions.OrderByDescending(v => v.VersionNumber).ToList();
            }
            else
            {
                errorMessage = verResp.ErrorMessage ?? "Не удалось загрузить историю версий файла.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при загрузке сведений о файле {FileId}", FileId);
            errorMessage = "Ошибка обмена с сервером при получении сведений о файле. Подробности записаны в журнал.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadDataAsync()
    {
        await LoadDataAsync();
    }

    private void RequestRestoreConfirmation(FileVersionDto version)
    {
        versionToRestore = version;
    }

    private void CancelRestoreConfirmation()
    {
        versionToRestore = null;
    }

    private async Task ExecuteRestoreAsync()
    {
        if (versionToRestore == null || activeProfile == null)
            return;

        isOperating = true;
        lastRestoreResult = null;
        int targetVer = versionToRestore.VersionNumber;

        try
        {
            lastRestoreResult = await BackupService.RestoreVersionAsync(
                activeProfile.BackupSetId,
                FileId,
                targetVer);

            versionToRestore = null;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка восстановления файла {FileId} до версии {Version}", FileId, targetVer);
            lastRestoreResult = new RestoreExecutionResult
            {
                Success = false,
                Status = "FAILED",
                ErrorCode = "CLIENT_EXCEPTION",
                ErrorMessage = "Ошибка обмена с сервером при восстановлении файла. Подробности записаны в журнал."
            };
            versionToRestore = null;
        }
        finally
        {
            isOperating = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "Б", "КБ", "МБ", "ГБ" };
        double size = bytes;
        int unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }
        return $"{size:0.##} {units[unitIndex]}";
    }

    private static string FormatTruncatedHash(string? hash)
    {
        if (string.IsNullOrEmpty(hash) || hash.Length <= 16)
            return hash ?? "—";
        return $"{hash[..8]}...{hash[^8..]}";
    }

    private readonly HashSet<string> _copiedHashes = new(StringComparer.OrdinalIgnoreCase);

    private async Task CopySha256Async(string? sha)
    {
        if (string.IsNullOrWhiteSpace(sha)) return;
        string clean = sha.Trim();
        bool ok = await ClipboardService.CopyTextAsync(clean);
        if (ok)
        {
            _copiedHashes.Add(clean);
            StateHasChanged();
            _ = Task.Run(async () =>
            {
                await Task.Delay(1500);
                _copiedHashes.Remove(clean);
                await InvokeAsync(StateHasChanged);
            });
        }
    }
}
