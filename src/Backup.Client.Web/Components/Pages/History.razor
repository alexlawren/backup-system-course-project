@page "/history"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncProfileService ProfileService
@inject ILogger<History> Logger

<PageTitle>Система резервного копирования - Журнал изменений</PageTitle>

<div class="system-container">
    <header class="system-header">
        <div class="badge-tag">Аудит — Журнал изменений PostgreSQL</div>
        <h1>Журнал изменений</h1>
        <p class="subtitle">Полный журнал аудита изменений: Создание, Изменение, Переименование, Удаление и Восстановление</p>
    </header>

    @if (isLoadingProfile)
    {
        <div class="card-section">
            <p>Загрузка профиля...</p>
        </div>
    }
    else if (activeProfile == null)
    {
        <div class="card-section">
            <div class="result-box error">
                <strong>Нет активного профиля синхронизации</strong>
                <p>Пожалуйста, сначала настройте набор на <a href="/" style="color: var(--accent);">Главной странице</a>.</p>
            </div>
        </div>
    }
    else
    {
        <section class="card-section">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h2>Журнал изменений: <span style="color: var(--accent);">@activeProfile.Name</span></h2>
                    <p style="font-size: 0.85rem; color: var(--text-secondary);">
                        Запрос через SyncGateway → MetadataService (неизменяемые аудит-записи)
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <label for="actionFilter" style="font-size: 0.85rem; color: var(--text-secondary);">Фильтр действий:</label>
                        <select id="actionFilter" class="form-input" style="width: auto; padding: 0.35rem 0.75rem;" @bind="selectedAction">
                            <option value="">Все действия</option>
                            <option value="CREATE">Создание</option>
                            <option value="MODIFY">Изменение</option>
                            <option value="RENAME">Переименование</option>
                            <option value="DELETE">Удаление</option>
                            <option value="RESTORE">Восстановление</option>
                        </select>
                    </div>
                    <button class="btn btn-secondary" @onclick="LoadLogAsync" disabled="@isLoadingLog">
                        <span>🔄 Обновить журнал</span>
                    </button>
                </div>
            </div>
        </section>

        <section class="card-section">
            @if (isLoadingLog)
            {
                <p>Загрузка записей журнала...</p>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="result-box error">
                    <strong>Ошибка:</strong>
                    <p>@errorMessage</p>
                </div>
            }
            else if (entries.Count == 0)
            {
                <p style="color: var(--text-secondary); text-align: center; padding: 2rem;">Записи в журнале изменений отсутствуют.</p>
            }
            else
            {
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Время (UTC)</th>
                                <th>Действие</th>
                                <th>Файл / Путь</th>
                                <th>Статус</th>
                                <th>Подробности</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in filteredEntries)
                            {
                                <tr>
                                    <td style="font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap;">
                                        @entry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="status-badge @GetActionBadgeClass(entry.Action)">
                                            @FormatActionDisplay(entry.Action)
                                        </span>
                                    </td>
                                    <td class="mono">
                                        @if (entry.FileId.HasValue && !string.IsNullOrEmpty(entry.RelativePath))
                                        {
                                            <a href="/files/@entry.FileId.Value" style="color: var(--accent); text-decoration: none;">
                                                @entry.RelativePath
                                            </a>
                                        }
                                        else if (!string.IsNullOrEmpty(entry.RelativePath))
                                        {
                                            <span>@entry.RelativePath</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-secondary);">—</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge badge-gray">@FormatStatusDisplay(entry.Status)</span>
                                    </td>
                                    <td style="font-size: 0.85rem; color: var(--text-secondary);">
                                        @(entry.Details ?? "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--text-secondary);">
                    <span>Отображается @filteredEntries.Count() из @entries.Count записей журнала</span>
                </div>
            }
        </section>
    }
</div>

@code {
    private SyncProfile? activeProfile;
    private bool isLoadingProfile = true;
    private bool isLoadingLog = false;
    private string? errorMessage;
    private List<ChangeLogEntryDto> entries = new();
    private string selectedAction = "";

    private IEnumerable<ChangeLogEntryDto> filteredEntries =>
        string.IsNullOrWhiteSpace(selectedAction)
            ? entries
            : entries.Where(e => string.Equals(e.Action, selectedAction, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            activeProfile = await ProfileService.GetProfileAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка получения профиля синхронизации");
            errorMessage = "Ошибка обмена с сервером. Подробности записаны в журнал.";
        }
        finally
        {
            isLoadingProfile = false;
        }

        if (activeProfile != null)
        {
            await LoadLogAsync();
        }
    }

    private async Task LoadLogAsync()
    {
        if (activeProfile == null) return;

        isLoadingLog = true;
        errorMessage = null;

        try
        {
            var response = await BackupService.GetChangeLogsAsync(activeProfile.BackupSetId, limit: 200);
            if (response.Success && response.Entries != null)
            {
                entries = response.Entries.OrderByDescending(e => e.CreatedAtUtc).ToList();
            }
            else
            {
                errorMessage = response.ErrorMessage ?? "Не удалось загрузить журнал изменений.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки журнала изменений");
            errorMessage = "Ошибка обмена с сервером при получении журнала. Подробности записаны в журнал.";
        }
        finally
        {
            isLoadingLog = false;
        }
    }

    private static string FormatActionDisplay(string action) => action.ToUpperInvariant() switch
    {
        "CREATE" => "Создание",
        "MODIFY" => "Изменение",
        "DELETE" => "Удаление",
        "RENAME" => "Переименование",
        "RESTORE" => "Восстановление",
        _ => action
    };

    private static string FormatStatusDisplay(string status) => status.ToUpperInvariant() switch
    {
        "SUCCESS" => "Успешно",
        "FAILED" => "Ошибка",
        "PENDING" => "В обработке",
        _ => status
    };

    private static string GetActionBadgeClass(string action) => action.ToUpperInvariant() switch
    {
        "CREATE" => "badge-green",
        "MODIFY" => "badge-amber",
        "DELETE" => "badge-red",
        "RENAME" => "badge-gray",
        "RESTORE" => "badge-green",
        _ => "badge-gray"
    };
}
