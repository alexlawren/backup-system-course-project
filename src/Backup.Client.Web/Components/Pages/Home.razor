@page "/"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncEngine SyncEngine
@inject ISyncProfileService ProfileService
@inject ILogger<Home> Logger

<PageTitle>Backup System - Directory Synchronization Diagnostic</PageTitle>

<div class="system-container">
    <header class="system-header">
        <div class="badge-tag">Change-set #6 — Restore Flow + File/Version Browser</div>
        <h1>Course Project / Backup System</h1>
        <p class="subtitle">«Клиент-серверная система резервного копирования файлов с автоматической синхронизацией и ведением журнала изменений»</p>
    </header>

    <!-- Services Status Section -->
    <section class="card-section">
        <h2>System Architecture & Connectivity</h2>
        <div class="status-grid">
            <div class="status-card @(isGatewayConnected ? "active" : "")">
                <div class="status-indicator @(isGatewayConnected ? "online" : "pending")"></div>
                <div class="status-info">
                    <span class="status-name">Sync Gateway</span>
                    <span class="status-role">TCP Entry Point (127.0.0.1:5000)</span>
                    <span class="status-badge @(isGatewayConnected ? "badge-green" : "badge-amber")">
                        @(isGatewayConnected ? "Connected" : "Disconnected / Offline")
                    </span>
                </div>
            </div>

            <div class="status-card @(SyncEngine.IsRunning ? "active" : "")">
                <div class="status-indicator @(SyncEngine.IsRunning ? "online" : "pending")"></div>
                <div class="status-info">
                    <span class="status-name">Automatic Sync Watcher</span>
                    <span class="status-role">FileSystemWatcher + Debounce (~750ms)</span>
                    <span class="status-badge @(SyncEngine.IsRunning ? "badge-green" : "badge-amber")">
                        @(SyncEngine.IsRunning ? "Running" : "Stopped")
                    </span>
                </div>
            </div>
        </div>

        <div style="margin-top: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button class="btn btn-secondary" @onclick="CheckGatewayConnectionAsync" disabled="@isLoading">
                <span>🔄 Ping Gateway</span>
            </button>
            <button class="btn btn-secondary" @onclick="RefreshStateAsync" disabled="@isLoading">
                <span>🔄 Refresh UI State</span>
            </button>
            <a href="/files" class="btn btn-primary" style="text-decoration: none;">
                <span>📂 Browse Files &amp; Restore</span>
            </a>
            <a href="/history" class="btn btn-secondary" style="text-decoration: none;">
                <span>📜 Change Log</span>
            </a>
        </div>
    </section>

    <!-- Client Identity Section -->
    <section class="card-section">
        <h2>Client Identity (Local Station)</h2>
        <div class="diagnostic-section">
            <div class="kv-table">
                <span class="kv-key">Machine Name:</span>
                <span class="kv-value">@(clientState?.MachineName ?? Environment.MachineName)</span>

                <span class="kv-key">Client ID:</span>
                <span class="kv-value">
                    @if (clientState?.ClientId != null && clientState.ClientId != Guid.Empty)
                    {
                        @clientState.ClientId
                    }
                    else
                    {
                        <span style="color: var(--warning);">Not registered yet</span>
                    }
                </span>

                <span class="kv-key">State Storage:</span>
                <span class="kv-value">data/client/client-state.json (atomic safe write)</span>
            </div>

            <div>
                <button class="btn btn-primary" @onclick="RegisterClientAsync" disabled="@isLoading">
                    <span>📝 Register Client via Gateway</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(clientStatusMessage))
            {
                <div class="status-badge @(clientStatusIsError ? "badge-amber" : "badge-green")">
                    @clientStatusMessage
                </div>
            }
        </div>
    </section>

    <!-- Active Backup Set & Profile Management -->
    <section class="card-section">
        <h2>Active Monitored Backup Set & Sync Profile</h2>
        <div class="diagnostic-section">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="backupSetName">Backup Set Name:</label>
                    <input id="backupSetName" class="form-input" @bind="backupSetName" placeholder="e.g. MyFolder" disabled="@isLoading" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="localRootPath">Local Root Directory Path:</label>
                    <input id="localRootPath" class="form-input" @bind="localRootPath" placeholder="e.g. D:\test_backup" disabled="@isLoading" />
                </div>
            </div>

            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                <button class="btn btn-primary" @onclick="CreateAndActivateProfileAsync" disabled="@(isLoading || string.IsNullOrWhiteSpace(backupSetName) || string.IsNullOrWhiteSpace(localRootPath))">
                    <span>📁 Save & Activate Backup Set</span>
                </button>
            </div>

            <div class="kv-table" style="margin-top: 1rem;">
                <span class="kv-key">Active Backup Set ID:</span>
                <span class="kv-value">@(activeBackupSetId != Guid.Empty ? activeBackupSetId.ToString() : "—")</span>

                <span class="kv-key">Active Directory:</span>
                <span class="kv-value">@(SyncEngine.CurrentLocalRootPath ?? activeLocalRootPath ?? "—")</span>

                <span class="kv-key">Automatic Sync Status:</span>
                <span class="kv-value">
                    <span class="status-badge @(SyncEngine.IsRunning ? "badge-green" : "badge-amber")">
                        @(SyncEngine.IsRunning ? "RUNNING" : "STOPPED")
                    </span>
                </span>

                <span class="kv-key">Last Reconciliation:</span>
                <span class="kv-value">@(SyncEngine.LastReconciliationUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")</span>

                <span class="kv-key">Last Sync Result:</span>
                <span class="kv-value">@(SyncEngine.LastSyncResult ?? "—")</span>

                <span class="kv-key">Pending Events (Debounce):</span>
                <span class="kv-value">@SyncEngine.PendingEventCount</span>

                <span class="kv-key">Reconciliation Required:</span>
                <span class="kv-value" style="color: @(SyncEngine.ReconciliationRequired ? "var(--warning)" : "var(--accent-color)");">
                    @(SyncEngine.ReconciliationRequired ? "YES (Needs Reconciliation)" : "NO (In Sync)")
                </span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap;">
                <button class="btn btn-primary" @onclick="StartAutomaticSyncAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty || SyncEngine.IsRunning)">
                    <span>▶️ Start Automatic Sync</span>
                </button>

                <button class="btn btn-secondary" @onclick="StopAutomaticSyncAsync" disabled="@(isLoading || !SyncEngine.IsRunning)">
                    <span>⏹️ Stop Automatic Sync</span>
                </button>

                <button class="btn btn-secondary" @onclick="ReconcileNowAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty)">
                    <span>⚡ Sync Now (Reconcile)</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(backupSetMessage))
            {
                <div class="status-badge @(backupSetIsError ? "badge-amber" : "badge-green")" style="margin-top: 0.75rem;">
                    @backupSetMessage
                </div>
            }
        </div>
    </section>

    <!-- Recent Sync Activity Log -->
    <section class="card-section">
        <h2>Recent Synchronization Events (Session Log)</h2>
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 0.75rem; max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
            @if (SyncEngine.RecentEvents.Count == 0)
            {
                <span style="color: var(--text-secondary);">No events recorded in current session.</span>
            }
            else
            {
                @foreach (var log in SyncEngine.RecentEvents.AsEnumerable().Reverse().Take(50))
                {
                    <div style="margin-bottom: 0.35rem; color: @(log.Level == "ERROR" ? "#f87171" : (log.Level == "WARN" ? "#fbbf24" : "#e2e8f0"));">
                        <span style="color: #94a3b8;">[@log.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")]</span> @log.Message
                    </div>
                }
            }
        </div>
    </section>

    <!-- Manual File Backup Test Section (Preserved for compatibility) -->
    <section class="card-section">
        <h2>Manual File Backup Test (Single File)</h2>
        <div class="diagnostic-section">
            <div class="form-group">
                <label class="form-label" for="manualFilePath">Absolute Local File Path:</label>
                <input id="manualFilePath" class="form-input" @bind="manualFilePath" placeholder="e.g. C:\backup_data\test.txt" disabled="@isLoading" />
            </div>

            <div>
                <button class="btn btn-primary" @onclick="BackupSingleFileAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))">
                    <span>🚀 Backup Single File</span>
                </button>
            </div>

            @if (backupOperationResult != null)
            {
                <div class="result-box @(backupOperationResult.Success ? "success" : "error")">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-weight: 600; font-size: 1.05rem;">
                            @(backupOperationResult.Success ? "✅ Backup Completed Successfully" : "❌ Backup Failed")
                        </span>
                        <span class="status-badge @(backupOperationResult.Success ? "badge-green" : "badge-red")">
                            @(backupOperationResult.Success ? "SUCCESS" : backupOperationResult.ErrorCode ?? "ERROR")
                        </span>
                    </div>

                    <div class="kv-table">
                        <span class="kv-key">File ID:</span>
                        <span class="kv-value">@(backupOperationResult.FileId?.ToString() ?? "—")</span>

                        <span class="kv-key">Version:</span>
                        <span class="kv-value">@(backupOperationResult.VersionNumber?.ToString() ?? "—")</span>

                        <span class="kv-key">Storage Key:</span>
                        <span class="kv-value">@(backupOperationResult.StorageKey ?? "—")</span>

                        @if (!backupOperationResult.Success)
                        {
                            <span class="kv-key">Error Code:</span>
                            <span class="kv-value" style="color: #f87171;">@backupOperationResult.ErrorCode</span>

                            <span class="kv-key">Error Message:</span>
                            <span class="kv-value" style="color: #f87171;">@backupOperationResult.ErrorMessage</span>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Protocol Specs Summary -->
    <section class="card-section protocol-overview">
        <h2>TCP Protocol v1 Specifications</h2>
        <div class="protocol-grid">
            <div class="protocol-item">
                <span class="label">Magic Marker</span>
                <span class="val">BKP1</span>
            </div>
            <div class="protocol-item">
                <span class="label">Protocol Version</span>
                <span class="val">1</span>
            </div>
            <div class="protocol-item">
                <span class="label">Framing Structure</span>
                <span class="val">[4B HeaderLen BigEndian] [JSON Header ≤ 64 KiB] [BodyStream]</span>
            </div>
            <div class="protocol-item">
                <span class="label">Transport Layer</span>
                <span class="val">Raw TCP Sockets (Streaming Relay without Full-File Buffering)</span>
            </div>
        </div>
    </section>
</div>

@code {
    private ClientState? clientState;
    private bool isGatewayConnected;
    private bool isLoading;

    private string clientStatusMessage = "";
    private bool clientStatusIsError;

    private string backupSetName = "DefaultSet";
    private string localRootPath = "";
    private string? activeLocalRootPath;
    private Guid activeBackupSetId = Guid.Empty;
    private string backupSetMessage = "";
    private bool backupSetIsError;

    private string manualFilePath = "";
    private UploadCompletedResponse? backupOperationResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientState = await BackupService.GetIdentityAsync();
            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                activeBackupSetId = profile.BackupSetId;
                backupSetName = profile.Name;
                localRootPath = profile.LocalRootPath;
                activeLocalRootPath = profile.LocalRootPath;
            }
            else if (string.IsNullOrEmpty(localRootPath))
            {
                localRootPath = Path.Combine(AppContext.BaseDirectory, "demo_sync");
            }

            await CheckGatewayConnectionAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing diagnostic UI");
        }
    }

    private async Task RefreshStateAsync()
    {
        await CheckGatewayConnectionAsync();
        clientState = await BackupService.GetIdentityAsync();
        var profile = await ProfileService.GetProfileAsync();
        if (profile != null)
        {
            activeBackupSetId = profile.BackupSetId;
            activeLocalRootPath = profile.LocalRootPath;
        }
        StateHasChanged();
    }

    private async Task CheckGatewayConnectionAsync()
    {
        isLoading = true;
        try
        {
            isGatewayConnected = await BackupService.PingGatewayAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegisterClientAsync()
    {
        isLoading = true;
        clientStatusMessage = "";
        try
        {
            var success = await BackupService.EnsureRegisteredAsync();
            if (success)
            {
                clientState = await BackupService.GetIdentityAsync();
                clientStatusMessage = $"Client successfully registered! ClientId: {clientState.ClientId}";
                clientStatusIsError = false;
            }
            else
            {
                clientStatusMessage = "Registration failed: Gateway or downstream error.";
                clientStatusIsError = true;
            }
        }
        catch (Exception ex)
        {
            clientStatusMessage = $"Error: {ex.Message}";
            clientStatusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAndActivateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(backupSetName) || string.IsNullOrWhiteSpace(localRootPath))
            return;

        // Backend directory existence validation (Section 24)
        if (!Directory.Exists(localRootPath))
        {
            try
            {
                Directory.CreateDirectory(localRootPath);
            }
            catch (Exception ex)
            {
                backupSetMessage = $"Invalid LocalRootPath: Directory does not exist and cannot be created ({ex.Message})";
                backupSetIsError = true;
                return;
            }
        }

        isLoading = true;
        backupSetMessage = "";
        try
        {
            var response = await BackupService.CreateBackupSetAsync(backupSetName, localRootPath);
            if (response.Success && response.BackupSetId != Guid.Empty)
            {
                activeBackupSetId = response.BackupSetId;
                activeLocalRootPath = localRootPath;

                var profile = new SyncProfile
                {
                    BackupSetId = response.BackupSetId,
                    Name = backupSetName,
                    LocalRootPath = localRootPath,
                    AutomaticSyncEnabled = SyncEngine.IsRunning
                };
                await ProfileService.SaveProfileAsync(profile);

                backupSetMessage = $"Backup set '{response.Name}' created and activated!";
                backupSetIsError = false;
            }
            else
            {
                backupSetMessage = $"Failed to create backup set: {response.ErrorMessage ?? "Unknown error"}";
                backupSetIsError = true;
            }
        }
        catch (Exception ex)
        {
            backupSetMessage = $"Error: {ex.Message}";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartAutomaticSyncAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(activeLocalRootPath))
        {
            backupSetMessage = "Please create or activate a backup set first.";
            backupSetIsError = true;
            return;
        }

        if (!Directory.Exists(activeLocalRootPath))
        {
            backupSetMessage = $"Directory '{activeLocalRootPath}' does not exist.";
            backupSetIsError = true;
            return;
        }

        isLoading = true;
        try
        {
            var profile = new SyncProfile
            {
                BackupSetId = activeBackupSetId,
                Name = backupSetName,
                LocalRootPath = activeLocalRootPath,
                AutomaticSyncEnabled = true
            };
            await ProfileService.SaveProfileAsync(profile);

            await SyncEngine.StartAsync(profile);
            backupSetMessage = "Automatic synchronization started.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            backupSetMessage = $"Failed to start automatic sync: {ex.Message}";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StopAutomaticSyncAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.StopAsync();

            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                profile.AutomaticSyncEnabled = false;
                await ProfileService.SaveProfileAsync(profile);
            }

            backupSetMessage = "Automatic synchronization stopped.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            backupSetMessage = $"Error stopping sync: {ex.Message}";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReconcileNowAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.ReconcileNowAsync();
            backupSetMessage = "Reconciliation finished.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            backupSetMessage = $"Reconciliation failed: {ex.Message}";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BackupSingleFileAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))
            return;

        isLoading = true;
        backupOperationResult = null;
        try
        {
            string root = activeLocalRootPath ?? localRootPath;
            backupOperationResult = await BackupService.BackupSingleFileAsync(activeBackupSetId, root, manualFilePath);
        }
        catch (Exception ex)
        {
            backupOperationResult = new UploadCompletedResponse
            {
                Success = false,
                ErrorCode = "CLIENT_EXCEPTION",
                ErrorMessage = ex.Message
            };
        }
        finally
        {
            isLoading = false;
        }
    }
}
