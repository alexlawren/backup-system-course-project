@page "/"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncEngine SyncEngine
@inject ISyncProfileService ProfileService
@inject ILogger<Home> Logger

<PageTitle>Система резервного копирования - Диагностика и управление</PageTitle>

<div class="system-container">
    <header class="system-header">
        <div class="badge-tag">Курсовой проект — Релиз 1.1</div>
        <h1>Курсовой проект / Система резервного копирования</h1>
        <p class="subtitle">«Клиент-серверная система резервного копирования файлов с автоматической синхронизацией и ведением журнала изменений»</p>
    </header>

    <!-- Блок Быстрый старт -->
    <section class="card-section quick-start-card">
        <h2>🚀 Быстрый старт</h2>
        <div class="quick-start-steps">
            <div class="step-item @(isGatewayConnected ? "step-done" : "step-pending")">
                <span class="step-number">1</span>
                <div class="step-content">
                    <strong>Проверьте соединение</strong>
                    <span>@(isGatewayConnected ? "✅ Шлюз подключен" : "Нажмите «Проверить соединение»")</span>
                </div>
            </div>
            <div class="step-item @(clientState?.ClientId != null && clientState.ClientId != Guid.Empty ? "step-done" : "step-pending")">
                <span class="step-number">2</span>
                <div class="step-content">
                    <strong>Зарегистрируйте клиент</strong>
                    <span>@(clientState?.ClientId != null && clientState.ClientId != Guid.Empty ? "✅ Зарегистрирован" : "Нажмите «Зарегистрировать клиент»")</span>
                </div>
            </div>
            <div class="step-item @(!string.IsNullOrWhiteSpace(activeLocalRootPath) ? "step-done" : "step-pending")">
                <span class="step-number">3</span>
                <div class="step-content">
                    <strong>Выберите папку</strong>
                    <span>@(!string.IsNullOrWhiteSpace(activeLocalRootPath) ? "✅ Папка выбрана" : "Укажите локальную папку")</span>
                </div>
            </div>
            <div class="step-item @(activeBackupSetId != Guid.Empty ? "step-done" : "step-pending")">
                <span class="step-number">4</span>
                <div class="step-content">
                    <strong>Сохраните набор</strong>
                    <span>@(activeBackupSetId != Guid.Empty ? "✅ Набор активен" : "«Сохранить и активировать»")</span>
                </div>
            </div>
            <div class="step-item @(SyncEngine.IsRunning ? "step-done" : "step-pending")">
                <span class="step-number">5</span>
                <div class="step-content">
                    <strong>Запустите синхронизацию</strong>
                    <span>@(SyncEngine.IsRunning ? "✅ Синхронизация активна" : "«Запустить синхронизацию»")</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Состояние системы -->
    <section class="card-section">
        <h2>Состояние системы</h2>
        <div class="status-grid">
            <div class="status-card @(isGatewayConnected ? "active" : "")">
                <div class="status-indicator @(isGatewayConnected ? "online" : "pending")"></div>
                <div class="status-info">
                    <span class="status-name">Шлюз синхронизации</span>
                    <span class="status-role">TCP точка входа (127.0.0.1:5000)</span>
                    <span class="status-badge @(isGatewayConnected ? "badge-green" : "badge-amber")">
                        @(isGatewayConnected ? "Подключено" : "Нет подключения")
                    </span>
                </div>
            </div>

            <div class="status-card @(SyncEngine.IsRunning ? "active" : "")">
                <div class="status-indicator @(SyncEngine.IsRunning ? "online" : "pending")"></div>
                <div class="status-info">
                    <span class="status-name">Автоматическая синхронизация</span>
                    <span class="status-role">FileSystemWatcher + Debounce (~750 мс)</span>
                    <span class="status-badge @(SyncEngine.IsRunning ? "badge-green" : "badge-amber")">
                        @(SyncEngine.IsRunning ? "Работает" : "Остановлено")
                    </span>
                </div>
            </div>

            <div class="status-card @(SyncEngine.IsReconciling || !SyncEngine.ReconciliationRequired ? "active" : "")">
                <div class="status-indicator @(SyncEngine.IsReconciling || !SyncEngine.ReconciliationRequired ? "online" : "pending")"></div>
                <div class="status-info">
                    <span class="status-name">Согласование данных</span>
                    <span class="status-role">Сверка метаданных клиент-сервер</span>
                    <span class="status-badge @(SyncEngine.IsReconciling ? "badge-gray" : (!SyncEngine.ReconciliationRequired ? "badge-green" : "badge-amber"))">
                        @(SyncEngine.IsReconciling ? "Выполняется" : (!SyncEngine.ReconciliationRequired ? "Синхронизировано" : "Требуется"))
                    </span>
                </div>
            </div>
        </div>

        <div style="margin-top: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button class="btn btn-secondary" @onclick="CheckGatewayConnectionAsync" disabled="@isLoading">
                <span>🔄 Проверить соединение</span>
            </button>
            <button class="btn btn-secondary" @onclick="RefreshStateAsync" disabled="@isLoading">
                <span>🔄 Обновить состояние</span>
            </button>
            <a href="/files" class="btn btn-primary" style="text-decoration: none;">
                <span>📂 Файлы и восстановление</span>
            </a>
            <a href="/history" class="btn btn-secondary" style="text-decoration: none;">
                <span>📜 Журнал изменений</span>
            </a>
        </div>
    </section>

    <!-- Локальный клиент -->
    <section class="card-section">
        <h2>Локальный клиент</h2>
        <div class="diagnostic-section">
            <div class="kv-table">
                <span class="kv-key">Имя компьютера:</span>
                <span class="kv-value">@(clientState?.MachineName ?? Environment.MachineName)</span>

                <span class="kv-key">Идентификатор клиента (ClientId):</span>
                <span class="kv-value">
                    @if (clientState?.ClientId != null && clientState.ClientId != Guid.Empty)
                    {
                        @clientState.ClientId
                    }
                    else
                    {
                        <span style="color: var(--warning);">Ещё не зарегистрирован</span>
                    }
                </span>

                <span class="kv-key">Локальное состояние:</span>
                <span class="kv-value">data/client/client-state.json (атомарная безопасная запись)</span>
            </div>

            <div>
                <button class="btn btn-primary" @onclick="RegisterClientAsync" disabled="@isLoading">
                    <span>📝 Зарегистрировать клиент</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(clientStatusMessage))
            {
                <div class="status-badge @(clientStatusIsError ? "badge-amber" : "badge-green")">
                    @clientStatusMessage
                </div>
            }
        </div>
    </section>

    <!-- Набор резервного копирования -->
    <section class="card-section">
        <h2>Набор резервного копирования</h2>
        <div class="diagnostic-section">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="backupSetName">Название набора:</label>
                    <input id="backupSetName" class="form-input" @bind="backupSetName" placeholder="Например: РабочиеДокументы" disabled="@isLoading" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="localRootPath">Папка для резервного копирования:</label>
                    <input id="localRootPath" class="form-input" @bind="localRootPath" placeholder="Например: D:\BackupDemo" disabled="@isLoading" />
                </div>
            </div>

            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                <button class="btn btn-primary" @onclick="CreateAndActivateProfileAsync" disabled="@(isLoading || string.IsNullOrWhiteSpace(backupSetName) || string.IsNullOrWhiteSpace(localRootPath))">
                    <span>📁 Сохранить и активировать</span>
                </button>
            </div>

            <div class="kv-table" style="margin-top: 1rem;">
                <span class="kv-key">Идентификатор активного набора:</span>
                <span class="kv-value">@(activeBackupSetId != Guid.Empty ? activeBackupSetId.ToString() : "—")</span>

                <span class="kv-key">Активная папка:</span>
                <span class="kv-value">@(SyncEngine.CurrentLocalRootPath ?? activeLocalRootPath ?? "—")</span>

                <span class="kv-key">Автоматическая синхронизация:</span>
                <span class="kv-value">
                    <span class="status-badge @(SyncEngine.IsRunning ? "badge-green" : "badge-amber")">
                        @(SyncEngine.IsRunning ? "РАБОТАЕТ" : "ОСТАНОВЛЕНО")
                    </span>
                </span>

                <span class="kv-key">Последнее согласование:</span>
                <span class="kv-value">@(SyncEngine.LastReconciliationUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Никогда")</span>

                <span class="kv-key">Файлов на сервере:</span>
                <span class="kv-value">@(totalFilesCount.HasValue ? totalFilesCount.Value.ToString() : "—")</span>

                <span class="kv-key">Последний результат:</span>
                <span class="kv-value">@(FormatSyncResult(SyncEngine.LastSyncResult) ?? "—")</span>

                <span class="kv-key">Ожидающих событий (Debounce):</span>
                <span class="kv-value">@SyncEngine.PendingEventCount</span>

                <span class="kv-key">Требуется согласование:</span>
                <span class="kv-value" style="color: @(SyncEngine.ReconciliationRequired ? "var(--warning)" : "var(--accent)");">
                    @(SyncEngine.ReconciliationRequired ? "ДА (требуется согласование)" : "НЕТ (синхронизировано)")
                </span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap;">
                <button class="btn btn-primary" @onclick="StartAutomaticSyncAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty || SyncEngine.IsRunning)">
                    <span>▶️ Запустить синхронизацию</span>
                </button>

                <button class="btn btn-secondary" @onclick="StopAutomaticSyncAsync" disabled="@(isLoading || !SyncEngine.IsRunning)">
                    <span>⏹️ Остановить синхронизацию</span>
                </button>

                <button class="btn btn-secondary" @onclick="ReconcileNowAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty)">
                    <span>⚡ Синхронизировать сейчас</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(backupSetMessage))
            {
                <div class="status-badge @(backupSetIsError ? "badge-amber" : "badge-green")" style="margin-top: 0.75rem;">
                    @backupSetMessage
                </div>
            }
        </div>
    </section>

    <!-- Последние события синхронизации -->
    <section class="card-section">
        <h2>Последние события синхронизации (Журнал сессии)</h2>
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 0.75rem; max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
            @if (SyncEngine.RecentEvents.Count == 0)
            {
                <span style="color: var(--text-secondary);">События в текущей сессии отсутствуют.</span>
            }
            else
            {
                @foreach (var log in SyncEngine.RecentEvents.AsEnumerable().Reverse().Take(50))
                {
                    <div style="margin-bottom: 0.35rem; color: @(log.Level == "ERROR" ? "#f87171" : (log.Level == "WARN" ? "#fbbf24" : "#e2e8f0"));">
                        <span style="color: #94a3b8;">[@log.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")]</span> @log.Message
                    </div>
                }
            }
        </div>
    </section>

    <!-- Ручная проверка резервного копирования одного файла -->
    <section class="card-section">
        <h2>Ручная проверка резервного копирования (Один файл)</h2>
        <div class="diagnostic-section">
            <div class="form-group">
                <label class="form-label" for="manualFilePath">Полный путь к локальному файлу:</label>
                <input id="manualFilePath" class="form-input" @bind="manualFilePath" placeholder="Например: D:\BackupDemo\test.txt" disabled="@isLoading" />
            </div>

            <div>
                <button class="btn btn-primary" @onclick="BackupSingleFileAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))">
                    <span>🚀 Резервировать файл</span>
                </button>
            </div>

            @if (backupOperationResult != null)
            {
                <div class="result-box @(backupOperationResult.Success ? "success" : "error")">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-weight: 600; font-size: 1.05rem;">
                            @(backupOperationResult.Success ? "✅ Файл успешно сохранён" : "❌ Ошибка резервного копирования")
                        </span>
                        <span class="status-badge @(backupOperationResult.Success ? "badge-green" : "badge-red")">
                            @(backupOperationResult.Success ? "УСПЕШНО" : backupOperationResult.ErrorCode ?? "ОШИБКА")
                        </span>
                    </div>

                    <div class="kv-table">
                        <span class="kv-key">Идентификатор файла (FileId):</span>
                        <span class="kv-value">@(backupOperationResult.FileId?.ToString() ?? "—")</span>

                        <span class="kv-key">Версия:</span>
                        <span class="kv-value">@(backupOperationResult.VersionNumber?.ToString() ?? "—")</span>

                        <span class="kv-key">Ключ хранилища:</span>
                        <span class="kv-value">@(backupOperationResult.StorageKey ?? "—")</span>

                        @if (!backupOperationResult.Success)
                        {
                            <span class="kv-key">Код ошибки:</span>
                            <span class="kv-value" style="color: #f87171;">@backupOperationResult.ErrorCode</span>

                            <span class="kv-key">Сообщение:</span>
                            <span class="kv-value" style="color: #f87171;">@backupOperationResult.ErrorMessage</span>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Спецификация протокола -->
    <section class="card-section protocol-overview">
        <h2>Спецификация протокола TCP Protocol v1</h2>
        <div class="protocol-grid">
            <div class="protocol-item">
                <span class="label">Сигнатура (Magic)</span>
                <span class="val">BKP1</span>
            </div>
            <div class="protocol-item">
                <span class="label">Версия протокола</span>
                <span class="val">1</span>
            </div>
            <div class="protocol-item">
                <span class="label">Структура фрейма</span>
                <span class="val">[4Б HeaderLen BigEndian] [JSON Заголовок ≤ 64 KiB] [Тело/Поток]</span>
            </div>
            <div class="protocol-item">
                <span class="label">Транспортный уровень</span>
                <span class="val">Raw TCP сокеты (потоковая передача без полной буферизации файлов)</span>
            </div>
        </div>
    </section>
</div>

@code {
    private ClientState? clientState;
    private bool isGatewayConnected;
    private bool isLoading;
    private int? totalFilesCount;

    private string clientStatusMessage = "";
    private bool clientStatusIsError;

    private string backupSetName = "DefaultSet";
    private string localRootPath = "";
    private string? activeLocalRootPath;
    private Guid activeBackupSetId = Guid.Empty;
    private string backupSetMessage = "";
    private bool backupSetIsError;

    private string manualFilePath = "";
    private UploadCompletedResponse? backupOperationResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientState = await BackupService.GetIdentityAsync();
            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                activeBackupSetId = profile.BackupSetId;
                backupSetName = profile.Name;
                localRootPath = profile.LocalRootPath;
                activeLocalRootPath = profile.LocalRootPath;
            }
            else
            {
                // Section 18: Never use source project directory as default backup root.
                // Keep localRootPath empty when no profile exists.
                localRootPath = "";
            }

            await CheckGatewayConnectionAsync();
            await LoadTotalFilesCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка инициализации интерфейса");
        }
    }

    private async Task RefreshStateAsync()
    {
        await CheckGatewayConnectionAsync();
        clientState = await BackupService.GetIdentityAsync();
        var profile = await ProfileService.GetProfileAsync();
        if (profile != null)
        {
            activeBackupSetId = profile.BackupSetId;
            activeLocalRootPath = profile.LocalRootPath;
        }
        await LoadTotalFilesCountAsync();
        StateHasChanged();
    }

    private async Task LoadTotalFilesCountAsync()
    {
        if (isGatewayConnected && activeBackupSetId != Guid.Empty)
        {
            try
            {
                var filesResp = await BackupService.GetFilesAsync(activeBackupSetId);
                if (filesResp.Success && filesResp.Files != null)
                {
                    totalFilesCount = filesResp.Files.Count;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Не удалось загрузить количество файлов на сервере");
                totalFilesCount = null;
            }
        }
    }

    private async Task CheckGatewayConnectionAsync()
    {
        isLoading = true;
        try
        {
            isGatewayConnected = await BackupService.PingGatewayAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка проверки соединения со шлюзом");
            isGatewayConnected = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegisterClientAsync()
    {
        isLoading = true;
        clientStatusMessage = "";
        try
        {
            var success = await BackupService.EnsureRegisteredAsync();
            if (success)
            {
                clientState = await BackupService.GetIdentityAsync();
                clientStatusMessage = $"Клиент успешно зарегистрирован! Идентификатор: {clientState.ClientId}";
                clientStatusIsError = false;
            }
            else
            {
                clientStatusMessage = "Ошибка регистрации: сервис метаданных или шлюз недоступен.";
                clientStatusIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при регистрации клиента");
            clientStatusMessage = "Ошибка обмена с сервером при регистрации. Подробности записаны в журнал.";
            clientStatusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAndActivateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(backupSetName) || string.IsNullOrWhiteSpace(localRootPath))
            return;

        if (!Directory.Exists(localRootPath))
        {
            try
            {
                Directory.CreateDirectory(localRootPath);
            }
            catch (Exception ex)
            {
                backupSetMessage = $"Недопустимый путь к папке: директория не существует и не может быть создана ({ex.Message})";
                backupSetIsError = true;
                return;
            }
        }

        isLoading = true;
        backupSetMessage = "";
        try
        {
            var response = await BackupService.CreateBackupSetAsync(backupSetName, localRootPath);
            if (response.Success && response.BackupSetId != Guid.Empty)
            {
                activeBackupSetId = response.BackupSetId;
                activeLocalRootPath = localRootPath;

                var profile = new SyncProfile
                {
                    BackupSetId = response.BackupSetId,
                    Name = backupSetName,
                    LocalRootPath = localRootPath,
                    AutomaticSyncEnabled = SyncEngine.IsRunning
                };
                await ProfileService.SaveProfileAsync(profile);

                backupSetMessage = $"Набор резервного копирования '{response.Name}' успешно создан и активирован!";
                backupSetIsError = false;
            }
            else
            {
                backupSetMessage = $"Не удалось создать набор: {response.ErrorMessage ?? "Неизвестная ошибка"}";
                backupSetIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при создании набора резервного копирования");
            backupSetMessage = "Ошибка обмена с сервером при создании набора. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartAutomaticSyncAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(activeLocalRootPath))
        {
            backupSetMessage = "Сначала создайте или активируйте набор резервного копирования.";
            backupSetIsError = true;
            return;
        }

        if (!Directory.Exists(activeLocalRootPath))
        {
            backupSetMessage = $"Директория '{activeLocalRootPath}' не существует.";
            backupSetIsError = true;
            return;
        }

        isLoading = true;
        try
        {
            var profile = new SyncProfile
            {
                BackupSetId = activeBackupSetId,
                Name = backupSetName,
                LocalRootPath = activeLocalRootPath,
                AutomaticSyncEnabled = true
            };
            await ProfileService.SaveProfileAsync(profile);

            await SyncEngine.StartAsync(profile);
            backupSetMessage = "Автоматическая синхронизация запущена.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при запуске автоматической синхронизации");
            backupSetMessage = "Ошибка запуска синхронизации. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StopAutomaticSyncAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.StopAsync();

            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                profile.AutomaticSyncEnabled = false;
                await ProfileService.SaveProfileAsync(profile);
            }

            backupSetMessage = "Автоматическая синхронизация остановлена.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при остановке синхронизации");
            backupSetMessage = "Ошибка остановки синхронизации. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReconcileNowAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.ReconcileNowAsync();
            await LoadTotalFilesCountAsync();
            backupSetMessage = "Согласование данных успешно завершено.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка согласования данных");
            backupSetMessage = "Ошибка согласования данных. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BackupSingleFileAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))
            return;

        isLoading = true;
        backupOperationResult = null;
        try
        {
            string root = activeLocalRootPath ?? localRootPath;
            backupOperationResult = await BackupService.BackupSingleFileAsync(activeBackupSetId, root, manualFilePath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка резервного копирования файла");
            backupOperationResult = new UploadCompletedResponse
            {
                Success = false,
                ErrorCode = "CLIENT_EXCEPTION",
                ErrorMessage = "Ошибка обмена с сервером при передаче файла. Подробности записаны в журнал."
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string? FormatSyncResult(string? result)
    {
        if (string.IsNullOrEmpty(result)) return null;
        if (result.Contains("All files in sync", StringComparison.OrdinalIgnoreCase))
            return "Все файлы согласованы";
        if (result.Contains("completed", StringComparison.OrdinalIgnoreCase))
            return "Согласование завершено";
        return result;
    }
}
