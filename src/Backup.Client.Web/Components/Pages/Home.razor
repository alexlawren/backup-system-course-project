    private async Task CreateAndActivateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(newBackupSetName) || string.IsNullOrWhiteSpace(newLocalRootPath))
            return;

        string normalizedRootPath = Path.GetFullPath(newLocalRootPath.Trim());
        if (!Directory.Exists(normalizedRootPath))
        {
            try
            {
                Directory.CreateDirectory(normalizedRootPath);
            }
            catch (Exception ex)
            {
                backupSetMessage = $"Недопустимый путь к папке: директория не существует и не может быть создана ({ex.Message})";
                backupSetIsError = true;
                return;
            }
        }

        isLoading = true;
        backupSetMessage = "";
        try
        {
            var response = await BackupService.CreateBackupSetAsync(newBackupSetName, normalizedRootPath, newBackupSetAccessMode);
            if (response.Success && response.BackupSetId != Guid.Empty)
            {
                activeBackupSetId = response.BackupSetId;
                activeBackupSetName = response.Name;
                activeLocalRootPath = normalizedRootPath;
                activeAccessMode = response.AccessMode;
                activeShareCode = response.ShareCode;

                var profile = new SyncProfile
                {
                    BackupSetId = response.BackupSetId,
                    Name = response.Name,
                    LocalRootPath = normalizedRootPath,
                    AutomaticSyncEnabled = SyncEngine.IsRunning,
                    AccessMode = response.AccessMode,
                    ShareCode = response.ShareCode
                };
                await ProfileService.SaveProfileAsync(profile);
                await SyncEngine.SwitchProfileAsync(profile);

                await LoadTotalFilesCountAsync();
                if (activeAccessMode == BackupSetAccessMode.Shared)
                {
                    await LoadMembersAsync();
                }
                backupSetMessage = $"Набор резервного копирования '{response.Name}' ({response.AccessMode}) успешно сохранён и активирован.";
                backupSetIsError = false;
            }
            else
            {
                backupSetMessage = $"Не удалось создать набор: {response.ErrorMessage ?? "Неизвестная ошибка"}";
                backupSetIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при создании набора резервного копирования");
            backupSetMessage = "Ошибка обмена с сервером при создании набора. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string shareCodeCopyBtnText = "Копировать";
    private string clientIdCopyBtnText = "Копировать";
    private CancellationTokenSource? _shareCodeFeedbackCts;
    private CancellationTokenSource? _clientIdFeedbackCts;

    private async Task CopyShareCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(activeShareCode)) return;
        string cleanCode = activeShareCode.Trim();
        bool success = await ClipboardService.CopyTextAsync(cleanCode);
        if (success)
        {
            backupSetMessage = "Код скопирован";
            backupSetIsError = false;
            shareCodeCopyBtnText = "Скопировано";
            _shareCodeFeedbackCts?.Cancel();
            _shareCodeFeedbackCts = new CancellationTokenSource();
            var token = _shareCodeFeedbackCts.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(1500, token);
                    shareCodeCopyBtnText = "Копировать";
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) { }
            }, token);
        }
        else
        {
            backupSetMessage = "Не удалось скопировать код";
            backupSetIsError = true;
        }
        StateHasChanged();
    }

    private async Task CopyClientIdAsync()
    {
        if (clientState?.ClientId == null || clientState.ClientId == Guid.Empty) return;
        string idStr = clientState.ClientId.Value.ToString();
        bool success = await ClipboardService.CopyTextAsync(idStr);
        if (success)
        {
            clientIdCopyBtnText = "Скопировано";
            _clientIdFeedbackCts?.Cancel();
            _clientIdFeedbackCts = new CancellationTokenSource();
            var token = _clientIdFeedbackCts.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(1500, token);
                    clientIdCopyBtnText = "Копировать";
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) { }
            }, token);
        }
        StateHasChanged();
    }

