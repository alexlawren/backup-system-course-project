    private async Task JoinSharedSetAsync()
    {
        if (string.IsNullOrWhiteSpace(joinShareCode) || string.IsNullOrWhiteSpace(joinLocalRootPath))
            return;

        string normalizedRoot = Path.GetFullPath(joinLocalRootPath.Trim());
        if (!Directory.Exists(normalizedRoot))
        {
            try
            {
                Directory.CreateDirectory(normalizedRoot);
            }
            catch (Exception ex)
            {
                joinMessage = $"Не удалось создать папку '{normalizedRoot}': {ex.Message}";
                joinIsError = true;
                return;
            }
        }

        isLoading = true;
        joinMessage = "";
        try
        {
            var joinResp = await BackupService.JoinSharedBackupSetAsync(joinShareCode.Trim());
            if (joinResp.Success && joinResp.BackupSetId.HasValue)
            {
                var setId = joinResp.BackupSetId.Value;
                var setName = joinResp.Name ?? "SharedSet";
                activeBackupSetId = setId;
                activeBackupSetName = setName;
                activeLocalRootPath = normalizedRoot;
                activeAccessMode = BackupSetAccessMode.Shared;
                activeShareCode = joinResp.ShareCode ?? joinShareCode.Trim();

                var profile = new SyncProfile
                {
                    BackupSetId = setId,
                    Name = setName,
                    LocalRootPath = normalizedRoot,
                    AutomaticSyncEnabled = true,
                    AccessMode = BackupSetAccessMode.Shared,
                    ShareCode = activeShareCode
                };

                await ProfileService.SaveProfileAsync(profile);
                await SyncEngine.SwitchProfileAsync(profile);
                await SyncEngine.ReconcileNowAsync();

                await LoadTotalFilesCountAsync();
                await LoadMembersAsync();

                joinMessage = $"Успешно подключено к общему набору '{setName}'. Выполнена начальная синхронизация.";
                joinIsError = false;
            }
            else
            {
                joinMessage = $"Ошибка подключения: {joinResp.ErrorMessage ?? joinResp.ErrorCode ?? "Неизвестная ошибка"}";
                joinIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при подключении к общему набору");
            joinMessage = $"Ошибка соединения: {ex.Message}";
            joinIsError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task StartAutomaticSyncAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(activeLocalRootPath))
        {
            backupSetMessage = "Сначала создайте или активируйте набор резервного копирования.";
            backupSetIsError = true;
            return;
        }

        if (!Directory.Exists(activeLocalRootPath))
        {
            backupSetMessage = $"Директория '{activeLocalRootPath}' не существует.";
            backupSetIsError = true;
            return;
        }

        isLoading = true;
        try
        {
            var existingProfile = await ProfileService.GetProfileAsync();
            var effectiveAccessMode = activeAccessMode;
            if (effectiveAccessMode != BackupSetAccessMode.Shared && existingProfile?.AccessMode == BackupSetAccessMode.Shared)
            {
                effectiveAccessMode = BackupSetAccessMode.Shared;
            }
            if (effectiveAccessMode != BackupSetAccessMode.Shared && SyncEngine.ActiveProfile?.AccessMode == BackupSetAccessMode.Shared)
            {
                effectiveAccessMode = BackupSetAccessMode.Shared;
            }
            if (effectiveAccessMode != BackupSetAccessMode.Shared && !string.IsNullOrWhiteSpace(activeShareCode ?? existingProfile?.ShareCode))
            {
                effectiveAccessMode = BackupSetAccessMode.Shared;
            }

            var effectiveShareCode = !string.IsNullOrWhiteSpace(activeShareCode)
                ? activeShareCode
                : (existingProfile?.ShareCode ?? SyncEngine.ActiveProfile?.ShareCode);

            var profile = new SyncProfile
            {
                BackupSetId = activeBackupSetId,
                Name = !string.IsNullOrWhiteSpace(activeBackupSetName)
                    ? activeBackupSetName
                    : (!string.IsNullOrWhiteSpace(existingProfile?.Name) ? existingProfile.Name : "BackupSet"),
                LocalRootPath = activeLocalRootPath,
                AutomaticSyncEnabled = true,
                AccessMode = effectiveAccessMode,
                ShareCode = effectiveShareCode
            };
            await ProfileService.SaveProfileAsync(profile);

            await SyncEngine.StartAsync(profile);
            backupSetMessage = "Автоматическая синхронизация запущена.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при запуске автоматической синхронизации");
            backupSetMessage = "Ошибка запуска синхронизации. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StopAutomaticSyncAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.StopAsync();

            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                profile.AutomaticSyncEnabled = false;
                await ProfileService.SaveProfileAsync(profile);
            }

            backupSetMessage = "Автоматическая синхронизация остановлена.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при остановке синхронизации");
            backupSetMessage = "Ошибка остановки синхронизации. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReconcileNowAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.ReconcileNowAsync();
            await LoadTotalFilesCountAsync();
            backupSetMessage = "Согласование данных успешно завершено.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка согласования данных");
            backupSetMessage = "Ошибка согласования данных. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BackupSingleFileAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))
            return;

        isLoading = true;
        backupOperationResult = null;
        try
        {
            string root = SyncEngine.CurrentLocalRootPath ?? activeLocalRootPath ?? newLocalRootPath;
            backupOperationResult = await BackupService.BackupSingleFileAsync(activeBackupSetId, root, manualFilePath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка резервного копирования файла");
            backupOperationResult = new UploadCompletedResponse
            {
                Success = false,
                ErrorCode = "CLIENT_EXCEPTION",
                ErrorMessage = "Ошибка обмена с сервером при передаче файла. Подробности записаны в журнал."
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string? FormatSyncResult(string? result)
    {
        if (string.IsNullOrEmpty(result)) return null;
        if (result.Contains("All files in sync", StringComparison.OrdinalIgnoreCase))
            return "Все файлы согласованы";
        if (result.Contains("completed", StringComparison.OrdinalIgnoreCase))
            return "Согласование завершено";
        return result;
    }

    private string GetReconciliationStatusText()
    {
        if (SyncEngine.HasConflict) return "Конфликт";
        if (SyncEngine.IsReconciling) return "Синхронизация...";
        if (SyncEngine.ReconciliationRequired) return "Требуется синхронизация";
        if (!isGatewayConnected) return "Нет соединения";
        if (SyncEngine.LastSyncResult?.Contains("error", StringComparison.OrdinalIgnoreCase) == true) return "Ошибка";
        return "Синхронизировано";
    }

    private string GetReconciliationDotClass()
    {
        if (SyncEngine.HasConflict) return "offline";
        if (SyncEngine.IsReconciling) return "pending";
        if (SyncEngine.ReconciliationRequired) return "warning";
        if (!isGatewayConnected) return "offline";
        if (SyncEngine.LastSyncResult?.Contains("error", StringComparison.OrdinalIgnoreCase) == true) return "warning";
        return "online";
    }

    private string GetCurrentClientRole()
    {
        var myMembership = membersList?.FirstOrDefault(m => m.ClientId == clientState?.ClientId);
        if (myMembership != null)
        {
            return myMembership.Role == "OWNER" ? "Владелец" : "Участник";
        }
        return "Владелец";
    }

    private async Task CopyToClipboard(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await ClipboardService.CopyTextAsync(text.Trim());
    }

    private string GetStateDisplayPath()
    {
        string? root = Configuration["ClientDataRoot"];
        if (string.IsNullOrWhiteSpace(root))
        {
            return "data/client/client-state.json";
        }

        string normalized = root.Replace('\\', '/');
        int idx = normalized.IndexOf("data/client", StringComparison.OrdinalIgnoreCase);
        if (idx >= 0)
        {
            return $"{normalized[idx..].TrimEnd('/')}/client-state.json";
        }
        return $"{normalized.TrimEnd('/')}/client-state.json";
    }
