@page "/"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncEngine SyncEngine
@inject ISyncProfileService ProfileService
@inject ILogger<Home> Logger

<PageTitle>Система резервного копирования</PageTitle>

<div class="page-header">
    <h1 class="page-title">Система резервного копирования</h1>
    <p class="page-subtitle">Состояние клиента и синхронизации</p>
</div>

<!-- Состояние системы -->
<section class="panel-section">
    <div class="panel-header">
        <h2 class="panel-title">Состояние системы</h2>
        <div class="panel-actions">
            <button class="btn btn-secondary btn-sm" @onclick="CheckGatewayConnectionAsync" disabled="@isLoading">
                Проверить соединение
            </button>
            <button class="btn btn-secondary btn-sm" @onclick="RefreshStateAsync" disabled="@isLoading">
                Обновить состояние
            </button>
        </div>
    </div>

    <div class="status-summary-grid">
        <div class="status-summary-item">
            <span class="status-label">Шлюз</span>
            <span class="status-value">
                <span class="status-dot @(isGatewayConnected ? "online" : "offline")"></span>
                @(isGatewayConnected ? "Подключён" : "Недоступен")
            </span>
        </div>

        <div class="status-summary-item">
            <span class="status-label">Синхронизация</span>
            <span class="status-value">
                <span class="status-dot @(SyncEngine.IsRunning ? "online" : "pending")"></span>
                @(SyncEngine.IsRunning ? "Работает" : "Остановлена")
            </span>
        </div>

        <div class="status-summary-item">
            <span class="status-label">Согласование</span>
            <span class="status-value">
                <span class="status-dot @(SyncEngine.HasConflict ? "offline" : (SyncEngine.IsReconciling ? "pending" : (!SyncEngine.ReconciliationRequired ? "online" : "warning")))"></span>
                @(SyncEngine.HasConflict ? "Конфликт" : (SyncEngine.IsReconciling ? "Синхронизация..." : (!SyncEngine.ReconciliationRequired ? "Синхронизировано" : "Требуется синхронизация")))
            </span>
        </div>

        <div class="status-summary-item">
            <span class="status-label">Последняя сверка</span>
            <span class="status-value mono">
                @(SyncEngine.LastReconciliationUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "Никогда")
            </span>
        </div>
    </div>
</section>

<!-- Быстрый старт -->
<section class="panel-section">
    <h2 class="panel-title">Быстрый старт</h2>
    <div class="checklist">
        <div class="checklist-item @(isGatewayConnected ? "done" : "")">
            <span class="checklist-num">1</span>
            <span class="checklist-name">Соединение с сервером</span>
            <span class="checklist-status">@(isGatewayConnected ? "✓ Подключено" : "Не подключено")</span>
        </div>

        <div class="checklist-item @(clientState?.ClientId != null && clientState.ClientId != Guid.Empty ? "done" : "")">
            <span class="checklist-num">2</span>
            <span class="checklist-name">Регистрация клиента</span>
            <span class="checklist-status">@(clientState?.ClientId != null && clientState.ClientId != Guid.Empty ? "✓ Зарегистрирован" : "Не зарегистрирован")</span>
        </div>

        <div class="checklist-item @(!string.IsNullOrWhiteSpace(activeLocalRootPath) ? "done" : "")">
            <span class="checklist-num">3</span>
            <span class="checklist-name">Папка резервного копирования</span>
            <span class="checklist-status mono">@(!string.IsNullOrWhiteSpace(activeLocalRootPath) ? activeLocalRootPath : "Не выбрана")</span>
        </div>

        <div class="checklist-item @(activeBackupSetId != Guid.Empty ? "done" : "")">
            <span class="checklist-num">4</span>
            <span class="checklist-name">Набор активирован</span>
            <span class="checklist-status">@(activeBackupSetId != Guid.Empty ? $"✓ {backupSetName}" : "Не активирован")</span>
        </div>

        <div class="checklist-item @(SyncEngine.IsRunning ? "done" : "")">
            <span class="checklist-num">5</span>
            <span class="checklist-name">Синхронизация</span>
            <span class="checklist-status">@(SyncEngine.IsRunning ? "✓ Работает" : "Остановлена")</span>
        </div>
    </div>
</section>

<!-- Локальный клиент -->
<section class="panel-section">
    <div class="panel-header">
        <h2 class="panel-title">Локальный клиент</h2>
        <div class="panel-actions">
            <button class="btn btn-primary btn-sm" @onclick="RegisterClientAsync" disabled="@isLoading">
                Зарегистрировать клиент
            </button>
        </div>
    </div>

    <div class="kv-grid">
        <div class="kv-row">
            <span class="kv-key">Имя компьютера:</span>
            <span class="kv-val">@(clientState?.MachineName ?? Environment.MachineName)</span>
        </div>

        <div class="kv-row">
            <span class="kv-key">Идентификатор (ClientId):</span>
            <span class="kv-val mono">
                @if (clientState?.ClientId != null && clientState.ClientId != Guid.Empty)
                {
                    @clientState.ClientId
                }
                else
                {
                    <span class="text-warning">Ещё не зарегистрирован</span>
                }
            </span>
        </div>

        <div class="kv-row">
            <span class="kv-key">Файл состояния:</span>
            <span class="kv-val mono">data/client/client-state.json</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(clientStatusMessage))
    {
        <div class="alert @(clientStatusIsError ? "alert-warning" : "alert-success")">
            @clientStatusMessage
        </div>
    }
</section>

<!-- Набор резервного копирования -->
<section class="panel-section">
    <h2 class="panel-title">Набор резервного копирования</h2>

    <div class="form-grid">
        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="backupSetName">Название набора:</label>
                <input id="backupSetName" class="form-input" @bind="backupSetName" placeholder="Например: DefaultSet" disabled="@isLoading" />
                <span class="form-helper">Имя профиля резервного копирования в базе данных</span>
            </div>
            <div class="form-group">
                <label class="form-label" for="localRootPath">Папка резервного копирования:</label>
                <input id="localRootPath" class="form-input" @bind="localRootPath" placeholder="Например: D:\BackupDemo" disabled="@isLoading" />
                <span class="form-helper">Локальный каталог для отслеживания и реконсиляции</span>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 0.5rem;">
            <label class="form-label">Тип набора:</label>
            <div style="display: flex; gap: 1.25rem; align-items: center; margin-top: 0.35rem;">
                <label style="cursor: pointer; display: flex; align-items: center; gap: 0.4rem; font-size: 0.95rem;">
                    <input type="radio" name="accessMode" value="@BackupSetAccessMode.Private" checked="@(selectedAccessMode == BackupSetAccessMode.Private)" @onchange="@(() => selectedAccessMode = BackupSetAccessMode.Private)" disabled="@isLoading" />
                    Личный (Private)
                </label>
                <label style="cursor: pointer; display: flex; align-items: center; gap: 0.4rem; font-size: 0.95rem;">
                    <input type="radio" name="accessMode" value="@BackupSetAccessMode.Shared" checked="@(selectedAccessMode == BackupSetAccessMode.Shared)" @onchange="@(() => selectedAccessMode = BackupSetAccessMode.Shared)" disabled="@isLoading" />
                    Общий (Shared)
                </label>
            </div>
            <span class="form-helper">Общий набор позволяет синхронизировать одну папку между несколькими рабочими станциями</span>
        </div>

        <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap;">
            <button class="btn btn-primary" @onclick="CreateAndActivateProfileAsync" disabled="@(isLoading || string.IsNullOrWhiteSpace(backupSetName) || string.IsNullOrWhiteSpace(localRootPath))">
                Сохранить и активировать
            </button>

            <button class="btn btn-success" @onclick="StartAutomaticSyncAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty || SyncEngine.IsRunning)">
                Запустить синхронизацию
            </button>

            <button class="btn btn-danger-subtle" @onclick="StopAutomaticSyncAsync" disabled="@(isLoading || !SyncEngine.IsRunning)">
                Остановить синхронизацию
            </button>

            <button class="btn btn-secondary" @onclick="ReconcileNowAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty)">
                Синхронизировать сейчас
            </button>
        </div>

        <div class="kv-grid" style="margin-top: 0.5rem;">
            <div class="kv-row">
                <span class="kv-key">Активный набор:</span>
                <span class="kv-val mono">@(activeBackupSetId != Guid.Empty ? $"{backupSetName} ({activeBackupSetId})" : "—")</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Тип набора:</span>
                <span class="kv-val">
                    @if (activeAccessMode == BackupSetAccessMode.Shared)
                    {
                        <span class="status-badge badge-blue">Общий (Shared)</span>
                    }
                    else
                    {
                        <span class="status-badge badge-gray">Личный (Private)</span>
                    }
                </span>
            </div>

            @if (activeAccessMode == BackupSetAccessMode.Shared)
            {
                @if (!string.IsNullOrEmpty(activeShareCode))
                {
                    <div class="kv-row">
                        <span class="kv-key">Код подключения:</span>
                        <span class="kv-val mono" style="font-size: 1.05rem; font-weight: 700; letter-spacing: 0.05em; color: var(--color-primary, #60a5fa);">
                            @activeShareCode
                            <button class="btn btn-secondary btn-sm" style="margin-left: 0.5rem; padding: 2px 8px;" @onclick="CopyShareCode">Копировать</button>
                        </span>
                    </div>
                }

                <div class="kv-row">
                    <span class="kv-key">Участники:</span>
                    <span class="kv-val">
                        @(membersList != null ? $"{membersList.Count} участник(ов)" : "1")
                        <button class="btn btn-secondary btn-sm" style="margin-left: 0.5rem; padding: 2px 8px;" @onclick="ToggleMembersViewAsync">
                            @(showMembers ? "Скрыть список" : "Показать участников")
                        </button>
                    </span>
                </div>

                @if (showMembers && membersList != null)
                {
                    <div style="margin-top: 0.5rem; background: var(--bg-surface, #1e293b); padding: 0.75rem; border-radius: 6px; border: 1px solid var(--border-color, #334155);">
                        <h4 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Участники набора:</h4>
                        <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.85rem;">
                            @foreach (var m in membersList)
                            {
                                <li style="margin-bottom: 0.25rem;">
                                    <strong>@(string.IsNullOrEmpty(m.ClientName) ? m.MachineName : m.ClientName)</strong> (@m.MachineName) —
                                    <span class="badge @(m.Role == "OWNER" ? "badge-primary" : "badge-secondary")">@(m.Role == "OWNER" ? "Владелец" : "Участник")</span>
                                    <span class="text-secondary mono" style="margin-left: 0.5rem;">(подключён @m.JoinedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }

            <div class="kv-row">
                <span class="kv-key">Активная папка:</span>
                <span class="kv-val mono">@(SyncEngine.CurrentLocalRootPath ?? activeLocalRootPath ?? "—")</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Файлов на сервере:</span>
                <span class="kv-val">@(totalFilesCount.HasValue ? totalFilesCount.Value.ToString() : "—")</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Ожидающих событий:</span>
                <span class="kv-val">@SyncEngine.PendingEventCount</span>
            </div>

            <div class="kv-row">
                <span class="kv-key">Последний результат:</span>
                <span class="kv-val">@(FormatSyncResult(SyncEngine.LastSyncResult) ?? "—")</span>
            </div>
        </div>

        @if (SyncEngine.HasConflict)
        {
            <div class="alert alert-warning" style="margin-top: 0.75rem;">
                <strong>Внимание! Обнаружены конфликты синхронизации (@SyncEngine.ActiveConflicts.Count):</strong>
                <ul style="margin: 0.5rem 0 0 1.25rem; font-size: 0.85rem;">
                    @foreach (var c in SyncEngine.ActiveConflicts)
                    {
                        <li><code>@c.RelativePath</code> — @c.ConflictType (сервер v@c.RemoteVersion). Автоматическая перезапись предотвращена. Сохранение конфликтующих копий отложено до Change-set #3.</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrEmpty(backupSetMessage))
        {
            <div class="alert @(backupSetIsError ? "alert-warning" : "alert-success")">
                @backupSetMessage
            </div>
        }
    </div>
</section>

<!-- Подключиться к общему набору -->
<section class="panel-section">
    <h2 class="panel-title">Подключиться к общему набору</h2>
    <div class="form-grid">
        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="joinShareCode">Код подключения:</label>
                <input id="joinShareCode" class="form-input mono" @bind="joinShareCode" placeholder="Например: 7H4K-92QX" disabled="@isLoading" />
                <span class="form-helper">9-символьный код, полученный от владельца набора</span>
            </div>
            <div class="form-group">
                <label class="form-label" for="joinLocalRootPath">Локальная папка:</label>
                <input id="joinLocalRootPath" class="form-input" @bind="joinLocalRootPath" placeholder="Например: D:\SharedDemoB" disabled="@isLoading" />
                <span class="form-helper">Каталог для скачивания и двусторонней синхронизации</span>
            </div>
        </div>

        <div>
            <button class="btn btn-primary" @onclick="JoinSharedSetAsync" disabled="@(isLoading || string.IsNullOrWhiteSpace(joinShareCode) || string.IsNullOrWhiteSpace(joinLocalRootPath))">
                Подключиться к общему набору
            </button>
        </div>

        @if (!string.IsNullOrEmpty(joinMessage))
        {
            <div class="alert @(joinIsError ? "alert-warning" : "alert-success")">
                @joinMessage
            </div>
        }
    </div>
</section>

<!-- Последние события синхронизации -->
<section class="panel-section">
    <h2 class="panel-title">Последние события синхронизации (Журнал сессии)</h2>
    <div class="log-console">
        @if (SyncEngine.RecentEvents.Count == 0)
        {
            <span class="text-secondary">События в текущей сессии отсутствуют.</span>
        }
        else
        {
            @foreach (var log in SyncEngine.RecentEvents.AsEnumerable().Reverse().Take(50))
            {
                <div class="log-entry" style="color: @(log.Level == "ERROR" ? "#f87171" : (log.Level == "WARN" ? "#fbbf24" : "#cbd5e1"));">
                    <span class="text-secondary">[@log.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")]</span> @log.Message
                </div>
            }
        }
    </div>
</section>

<!-- Ручная проверка резервного копирования (Один файл) -->
<section class="panel-section">
    <h2 class="panel-title">Ручная проверка резервного копирования (Один файл)</h2>
    <div class="form-grid">
        <div class="form-group">
            <label class="form-label" for="manualFilePath">Полный путь к локальному файлу:</label>
            <input id="manualFilePath" class="form-input" @bind="manualFilePath" placeholder="Например: D:\BackupDemo\test.txt" disabled="@isLoading" />
        </div>

        <div>
            <button class="btn btn-primary" @onclick="BackupSingleFileAsync" disabled="@(isLoading || activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))">
                Резервировать файл
            </button>
        </div>

        @if (backupOperationResult != null)
        {
            <div class="result-box @(backupOperationResult.Success ? "success" : "error")">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <span style="font-weight: 600;">
                        @(backupOperationResult.Success ? "Файл успешно сохранён" : "Ошибка резервного копирования")
                    </span>
                    <span class="status-badge @(backupOperationResult.Success ? "badge-green" : "badge-red")">
                        @(backupOperationResult.Success ? "Успешно" : backupOperationResult.ErrorCode ?? "Ошибка")
                    </span>
                </div>

                <div class="kv-grid">
                    <div class="kv-row">
                        <span class="kv-key">Идентификатор файла:</span>
                        <span class="kv-val mono">@(backupOperationResult.FileId?.ToString() ?? "—")</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Версия:</span>
                        <span class="kv-val mono">@(backupOperationResult.VersionNumber.HasValue ? $"v{backupOperationResult.VersionNumber.Value}" : "—")</span>
                    </div>

                    <div class="kv-row">
                        <span class="kv-key">Ключ хранилища:</span>
                        <span class="kv-val mono">@(backupOperationResult.StorageKey ?? "—")</span>
                    </div>

                    @if (!backupOperationResult.Success)
                    {
                        <div class="kv-row">
                            <span class="kv-key">Код ошибки:</span>
                            <span class="kv-val text-danger">@backupOperationResult.ErrorCode</span>
                        </div>

                        <div class="kv-row">
                            <span class="kv-key">Сообщение:</span>
                            <span class="kv-val text-danger">@backupOperationResult.ErrorMessage</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Спецификация сетевого протокола -->
<section class="panel-section">
    <h2 class="panel-title">Спецификация сетевого протокола TCP Protocol v1</h2>
    <div class="protocol-grid">
        <div class="protocol-item">
            <span class="label">Сигнатура (Magic)</span>
            <span class="val">BKP1</span>
        </div>
        <div class="protocol-item">
            <span class="label">Версия протокола</span>
            <span class="val">1</span>
        </div>
        <div class="protocol-item">
            <span class="label">Структура фрейма</span>
            <span class="val">[4Б HeaderLen BE] [JSON ≤ 64 KiB] [Тело]</span>
        </div>
        <div class="protocol-item">
            <span class="label">Транспорт</span>
            <span class="val">Raw TCP сокеты (буфер 64 KiB)</span>
        </div>
    </div>
</section>

@code {
    private ClientState? clientState;
    private bool isGatewayConnected;
    private bool isLoading;
    private int? totalFilesCount;

    private string clientStatusMessage = "";
    private bool clientStatusIsError;

    private string backupSetName = "DefaultSet";
    private string localRootPath = "";
    private string? activeLocalRootPath;
    private Guid activeBackupSetId = Guid.Empty;
    private string backupSetMessage = "";
    private bool backupSetIsError;

    private BackupSetAccessMode selectedAccessMode = BackupSetAccessMode.Private;
    private BackupSetAccessMode activeAccessMode = BackupSetAccessMode.Private;
    private string? activeShareCode;
    private List<BackupSetMemberDto>? membersList;
    private bool showMembers;

    private string joinShareCode = "";
    private string joinLocalRootPath = "";
    private string joinMessage = "";
    private bool joinIsError;

    private string manualFilePath = "";
    private UploadCompletedResponse? backupOperationResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientState = await BackupService.GetIdentityAsync();
            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                activeBackupSetId = profile.BackupSetId;
                backupSetName = profile.Name;
                localRootPath = profile.LocalRootPath;
                activeLocalRootPath = profile.LocalRootPath;
                activeAccessMode = profile.AccessMode;
                activeShareCode = profile.ShareCode;
                if (activeAccessMode == BackupSetAccessMode.Shared)
                {
                    await LoadMembersAsync();
                }
            }
            else
            {
                localRootPath = "";
            }

            await CheckGatewayConnectionAsync();
            await LoadTotalFilesCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка инициализации интерфейса");
        }
    }

    private async Task RefreshStateAsync()
    {
        await CheckGatewayConnectionAsync();
        clientState = await BackupService.GetIdentityAsync();
        var profile = await ProfileService.GetProfileAsync();
        if (profile != null)
        {
            activeBackupSetId = profile.BackupSetId;
            activeLocalRootPath = profile.LocalRootPath;
            backupSetName = profile.Name;
            activeAccessMode = profile.AccessMode;
            activeShareCode = profile.ShareCode;
            if (activeAccessMode == BackupSetAccessMode.Shared)
            {
                await LoadMembersAsync();
            }
        }
        await LoadTotalFilesCountAsync();
        StateHasChanged();
    }

    private async Task LoadTotalFilesCountAsync()
    {
        if (isGatewayConnected && activeBackupSetId != Guid.Empty)
        {
            try
            {
                var filesResp = await BackupService.GetFilesAsync(activeBackupSetId);
                if (filesResp.Success && filesResp.Files != null)
                {
                    totalFilesCount = filesResp.Files.Count;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Не удалось загрузить количество файлов на сервере");
                totalFilesCount = null;
            }
        }
    }

    private async Task CheckGatewayConnectionAsync()
    {
        isLoading = true;
        try
        {
            isGatewayConnected = await BackupService.PingGatewayAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка проверки соединения со шлюзом");
            isGatewayConnected = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegisterClientAsync()
    {
        isLoading = true;
        clientStatusMessage = "";
        try
        {
            var success = await BackupService.EnsureRegisteredAsync();
            if (success)
            {
                clientState = await BackupService.GetIdentityAsync();
                clientStatusMessage = $"Клиент успешно зарегистрирован. Идентификатор: {clientState.ClientId}";
                clientStatusIsError = false;
            }
            else
            {
                clientStatusMessage = "Ошибка регистрации: сервис метаданных или шлюз недоступен.";
                clientStatusIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при регистрации клиента");
            clientStatusMessage = "Ошибка обмена с сервером при регистрации. Подробности записаны в журнал.";
            clientStatusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAndActivateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(backupSetName) || string.IsNullOrWhiteSpace(localRootPath))
            return;

        string normalizedRootPath = Path.GetFullPath(localRootPath.Trim());
        if (!Directory.Exists(normalizedRootPath))
        {
            try
            {
                Directory.CreateDirectory(normalizedRootPath);
            }
            catch (Exception ex)
            {
                backupSetMessage = $"Недопустимый путь к папке: директория не существует и не может быть создана ({ex.Message})";
                backupSetIsError = true;
                return;
            }
        }

        isLoading = true;
        backupSetMessage = "";
        try
        {
            var response = await BackupService.CreateBackupSetAsync(backupSetName, normalizedRootPath, selectedAccessMode);
            if (response.Success && response.BackupSetId != Guid.Empty)
            {
                activeBackupSetId = response.BackupSetId;
                backupSetName = response.Name;
                localRootPath = normalizedRootPath;
                activeLocalRootPath = normalizedRootPath;
                activeAccessMode = response.AccessMode;
                activeShareCode = response.ShareCode;

                var profile = new SyncProfile
                {
                    BackupSetId = response.BackupSetId,
                    Name = backupSetName,
                    LocalRootPath = normalizedRootPath,
                    AutomaticSyncEnabled = SyncEngine.IsRunning,
                    AccessMode = response.AccessMode,
                    ShareCode = response.ShareCode
                };
                await ProfileService.SaveProfileAsync(profile);
                await SyncEngine.SwitchProfileAsync(profile);

                await LoadTotalFilesCountAsync();
                if (activeAccessMode == BackupSetAccessMode.Shared)
                {
                    await LoadMembersAsync();
                }
                backupSetMessage = $"Набор резервного копирования '{response.Name}' ({response.AccessMode}) успешно сохранён и активирован.";
                backupSetIsError = false;
            }
            else
            {
                backupSetMessage = $"Не удалось создать набор: {response.ErrorMessage ?? "Неизвестная ошибка"}";
                backupSetIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при создании набора резервного копирования");
            backupSetMessage = "Ошибка обмена с сервером при создании набора. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CopyShareCode()
    {
        if (!string.IsNullOrEmpty(activeShareCode))
        {
            backupSetMessage = $"Код подключения: {activeShareCode} скопирован в буфер/готов для использования.";
            backupSetIsError = false;
        }
    }

    private async Task ToggleMembersViewAsync()
    {
        showMembers = !showMembers;
        if (showMembers && activeBackupSetId != Guid.Empty)
        {
            await LoadMembersAsync();
        }
    }

    private async Task LoadMembersAsync()
    {
        if (activeBackupSetId != Guid.Empty)
        {
            try
            {
                var resp = await BackupService.GetBackupSetMembersAsync(activeBackupSetId);
                if (resp.Success)
                {
                    membersList = resp.Members;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Не удалось загрузить участников набора");
            }
        }
    }

    private async Task JoinSharedSetAsync()
    {
        if (string.IsNullOrWhiteSpace(joinShareCode) || string.IsNullOrWhiteSpace(joinLocalRootPath))
            return;

        string normalizedRoot = Path.GetFullPath(joinLocalRootPath.Trim());
        if (!Directory.Exists(normalizedRoot))
        {
            try
            {
                Directory.CreateDirectory(normalizedRoot);
            }
            catch (Exception ex)
            {
                joinMessage = $"Не удалось создать папку '{normalizedRoot}': {ex.Message}";
                joinIsError = true;
                return;
            }
        }

        isLoading = true;
        joinMessage = "";
        try
        {
            var joinResp = await BackupService.JoinSharedBackupSetAsync(joinShareCode.Trim());
            if (joinResp.Success && joinResp.BackupSetId.HasValue)
            {
                var setId = joinResp.BackupSetId.Value;
                var setName = joinResp.Name ?? "SharedSet";
                activeBackupSetId = setId;
                backupSetName = setName;
                localRootPath = normalizedRoot;
                activeLocalRootPath = normalizedRoot;
                activeAccessMode = BackupSetAccessMode.Shared;
                activeShareCode = joinResp.ShareCode ?? joinShareCode.Trim();

                var profile = new SyncProfile
                {
                    BackupSetId = setId,
                    Name = setName,
                    LocalRootPath = normalizedRoot,
                    AutomaticSyncEnabled = true,
                    AccessMode = BackupSetAccessMode.Shared,
                    ShareCode = activeShareCode
                };

                await ProfileService.SaveProfileAsync(profile);
                await SyncEngine.SwitchProfileAsync(profile);
                await SyncEngine.ReconcileNowAsync();

                await LoadTotalFilesCountAsync();
                await LoadMembersAsync();

                joinMessage = $"Успешно подключено к общему набору '{setName}'. Выполнена начальная синхронизация.";
                joinIsError = false;
            }
            else
            {
                joinMessage = $"Ошибка подключения: {joinResp.ErrorMessage ?? joinResp.ErrorCode ?? "Неизвестная ошибка"}";
                joinIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при подключении к общему набору");
            joinMessage = $"Ошибка соединения: {ex.Message}";
            joinIsError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task StartAutomaticSyncAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(activeLocalRootPath))
        {
            backupSetMessage = "Сначала создайте или активируйте набор резервного копирования.";
            backupSetIsError = true;
            return;
        }

        if (!Directory.Exists(activeLocalRootPath))
        {
            backupSetMessage = $"Директория '{activeLocalRootPath}' не существует.";
            backupSetIsError = true;
            return;
        }

        isLoading = true;
        try
        {
            var profile = new SyncProfile
            {
                BackupSetId = activeBackupSetId,
                Name = backupSetName,
                LocalRootPath = activeLocalRootPath,
                AutomaticSyncEnabled = true
            };
            await ProfileService.SaveProfileAsync(profile);

            await SyncEngine.StartAsync(profile);
            backupSetMessage = "Автоматическая синхронизация запущена.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при запуске автоматической синхронизации");
            backupSetMessage = "Ошибка запуска синхронизации. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StopAutomaticSyncAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.StopAsync();

            var profile = await ProfileService.GetProfileAsync();
            if (profile != null)
            {
                profile.AutomaticSyncEnabled = false;
                await ProfileService.SaveProfileAsync(profile);
            }

            backupSetMessage = "Автоматическая синхронизация остановлена.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при остановке синхронизации");
            backupSetMessage = "Ошибка остановки синхронизации. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReconcileNowAsync()
    {
        isLoading = true;
        try
        {
            await SyncEngine.ReconcileNowAsync();
            await LoadTotalFilesCountAsync();
            backupSetMessage = "Согласование данных успешно завершено.";
            backupSetIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка согласования данных");
            backupSetMessage = "Ошибка согласования данных. Подробности записаны в журнал.";
            backupSetIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BackupSingleFileAsync()
    {
        if (activeBackupSetId == Guid.Empty || string.IsNullOrWhiteSpace(manualFilePath))
            return;

        isLoading = true;
        backupOperationResult = null;
        try
        {
            string root = SyncEngine.CurrentLocalRootPath ?? activeLocalRootPath ?? localRootPath;
            backupOperationResult = await BackupService.BackupSingleFileAsync(activeBackupSetId, root, manualFilePath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка резервного копирования файла");
            backupOperationResult = new UploadCompletedResponse
            {
                Success = false,
                ErrorCode = "CLIENT_EXCEPTION",
                ErrorMessage = "Ошибка обмена с сервером при передаче файла. Подробности записаны в журнал."
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string? FormatSyncResult(string? result)
    {
        if (string.IsNullOrEmpty(result)) return null;
        if (result.Contains("All files in sync", StringComparison.OrdinalIgnoreCase))
            return "Все файлы согласованы";
        if (result.Contains("completed", StringComparison.OrdinalIgnoreCase))
            return "Согласование завершено";
        return result;
    }
}
