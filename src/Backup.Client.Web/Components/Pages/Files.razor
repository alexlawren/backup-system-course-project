@page "/files"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.DTOs
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncProfileService ProfileService
@inject NavigationManager Navigation
@inject ILogger<Files> Logger

<PageTitle>Система резервного копирования - Файлы и версии</PageTitle>

<div class="system-container">
    <header class="system-header">
        <div class="badge-tag">Каталог файлов</div>
        <h1>Файлы резервной копии</h1>
        <p class="subtitle">Каталог файлов активного набора (SyncGateway → MetadataService)</p>
    </header>

    @if (isLoadingProfile)
    {
        <div class="card-section">
            <p>Загрузка профиля...</p>
        </div>
    }
    else if (activeProfile == null)
    {
        <div class="card-section">
            <div class="result-box error">
                <strong>Нет активного профиля синхронизации</strong>
                <p>Пожалуйста, сначала настройте и активируйте набор на <a href="/" style="color: var(--accent);">Главной странице</a>.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Секция управления и фильтров -->
        <section class="card-section">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h2>Набор: <span style="color: var(--accent);">@activeProfile.Name</span></h2>
                    <p style="font-size: 0.85rem; color: var(--text-secondary); font-family: ui-monospace, monospace;">
                        Папка: @activeProfile.LocalRootPath
                    </p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; cursor: pointer;">
                        <input type="checkbox" @bind="includeDeleted" @bind:after="LoadFilesAsync" />
                        <span>Включая удалённые файлы</span>
                    </label>
                    <button class="btn btn-secondary" @onclick="LoadFilesAsync" disabled="@isLoadingFiles">
                        <span>🔄 Обновить</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Таблица файлов -->
        <section class="card-section">
            @if (isLoadingFiles)
            {
                <p>Загрузка списка файлов из шлюза...</p>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="result-box error">
                    <strong>Ошибка загрузки файлов:</strong>
                    <p>@errorMessage</p>
                </div>
            }
            else if (files.Count == 0)
            {
                <div style="text-align: center; padding: 2rem; color: var(--text-secondary);">
                    <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">📂 Файлы в данном наборе отсутствуют.</p>
                    <p style="font-size: 0.9rem;">Файлы появятся здесь после запуска синхронизации или сохранения первого файла.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Относительный путь</th>
                                <th>Версия</th>
                                <th>Размер</th>
                                <th>Статус</th>
                                <th>Изменён (UTC)</th>
                                <th style="text-align: right;">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in files)
                            {
                                <tr>
                                    <td class="mono" style="font-weight: 500;">
                                        <a href="/files/@file.FileId" style="color: var(--accent); text-decoration: none;">
                                            @file.RelativePath
                                        </a>
                                    </td>
                                    <td>
                                        <span class="status-badge badge-gray">v@file.CurrentVersionNumber</span>
                                    </td>
                                    <td class="mono">
                                        @(file.CurrentSize.HasValue ? FormatSize(file.CurrentSize.Value) : "—")
                                    </td>
                                    <td>
                                        @if (file.IsDeleted)
                                        {
                                            <span class="status-badge badge-red">Удалён</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-green">Активен</span>
                                        }
                                    </td>
                                    <td style="font-size: 0.8rem; color: var(--text-secondary);">
                                        @file.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>
                                    <td style="text-align: right;">
                                        <a href="/files/@file.FileId" class="btn btn-secondary" style="text-decoration: none; padding: 0.35rem 0.75rem; font-size: 0.8rem;">
                                            📜 Версии
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; justify-content: space-between;">
                    <span>Всего файлов: @files.Count</span>
                    <span>Активных: @files.Count(f => !f.IsDeleted) | Удалённых: @files.Count(f => f.IsDeleted)</span>
                </div>
            }
        </section>
    }
</div>

@code {
    private SyncProfile? activeProfile;
    private bool isLoadingProfile = true;
    private bool isLoadingFiles = false;
    private bool includeDeleted = true;
    private string? errorMessage;
    private List<FileMetadataDto> files = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            activeProfile = await ProfileService.GetProfileAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки профиля синхронизации");
            errorMessage = "Ошибка обмена с сервером. Подробности записаны в журнал.";
        }
        finally
        {
            isLoadingProfile = false;
        }

        if (activeProfile != null)
        {
            await LoadFilesAsync();
        }
    }

    private async Task LoadFilesAsync()
    {
        if (activeProfile == null) return;

        isLoadingFiles = true;
        errorMessage = null;

        try
        {
            var response = await BackupService.GetFilesAsync(activeProfile.BackupSetId, includeDeleted);
            if (response.Success && response.Files != null)
            {
                files = response.Files.OrderBy(f => f.RelativePath).ToList();
            }
            else
            {
                errorMessage = response.ErrorMessage ?? "Не удалось получить список файлов с сервера.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка получения списка файлов");
            errorMessage = "Ошибка обмена с сервером при получении списка файлов. Подробности записаны в журнал.";
        }
        finally
        {
            isLoadingFiles = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} Б";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} КБ";
        if (bytes < 1024 * 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):F2} МБ";
        return $"{(bytes / (1024.0 * 1024.0 * 1024.0)):F2} ГБ";
    }
}
