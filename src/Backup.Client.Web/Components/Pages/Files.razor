@page "/files"
@rendermode InteractiveServer
@using Backup.Client.Web.Services
@using Backup.Shared.DTOs
@using Backup.Shared.Messages
@inject IBackupClientService BackupService
@inject ISyncProfileService ProfileService
@inject NavigationManager Navigation
@inject ILogger<Files> Logger

<PageTitle>Файлы резервной копии</PageTitle>

<div class="page-header">
    <h1 class="page-title">Файлы резервной копии</h1>
    <p class="page-subtitle">Каталог файлов активного набора синхронизации</p>
</div>

@if (isLoadingProfile)
{
    <section class="panel-section">
        <p class="text-secondary">Загрузка профиля синхронизации...</p>
    </section>
}
else if (activeProfile == null)
{
    <section class="panel-section">
        <div class="alert alert-warning">
            <strong>Нет активного профиля синхронизации.</strong>
            Пожалуйста, сначала укажите папку и активируйте набор на <a href="/" style="color: var(--accent); text-decoration: underline;">Главной странице</a>.
        </div>
    </section>
}
else
{
    <!-- Секция управления и фильтров -->
    <section class="panel-section">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Набор: <span class="mono" style="color: var(--accent);">@activeProfile.Name</span></h2>
                <p class="mono text-secondary" style="font-size: 0.8rem; margin-top: 0.2rem;">
                    Папка: @activeProfile.LocalRootPath
                </p>
            </div>
            <div class="panel-actions">
                <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="includeDeleted" @bind:after="LoadFilesAsync" />
                    <span>Показывать удалённые</span>
                </label>
                <button class="btn btn-secondary btn-sm" @onclick="LoadFilesAsync" disabled="@isLoadingFiles">
                    Обновить
                </button>
            </div>
        </div>

        @if (isLoadingFiles)
        {
            <p class="text-secondary" style="padding: 1rem 0;">Загрузка списка файлов из шлюза...</p>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <strong>Ошибка:</strong> @errorMessage
            </div>
        }
        else if (files.Count == 0)
        {
            <div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary);">
                <p style="font-size: 1rem; margin-bottom: 0.25rem;">Файлы в данном наборе отсутствуют.</p>
                <p style="font-size: 0.825rem;">Они появятся здесь после запуска синхронизации или сохранения первого файла.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Файл</th>
                            <th>Версия</th>
                            <th>Размер</th>
                            <th>Статус</th>
                            <th>Изменён (UTC)</th>
                            <th style="text-align: right;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in files)
                        {
                            <tr>
                                <td class="mono" style="font-weight: 500;">
                                    <a href="/files/@file.FileId" style="color: var(--accent); text-decoration: none;">
                                        @file.RelativePath
                                    </a>
                                </td>
                                <td>
                                    <span class="status-badge badge-gray">@($"v{file.CurrentVersionNumber}")</span>
                                </td>
                                <td class="mono">
                                    @(file.CurrentSize.HasValue ? FormatSize(file.CurrentSize.Value) : "—")
                                </td>
                                <td>
                                    @if (file.IsDeleted)
                                    {
                                        <span class="status-badge badge-red">Удалён</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-green">Активен</span>
                                    }
                                </td>
                                <td style="font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap;">
                                    @file.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")
                                </td>
                                <td style="text-align: right;">
                                    <a href="/files/@file.FileId" class="btn btn-secondary btn-sm" style="text-decoration: none;">
                                        Версии
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="font-size: 0.8rem; color: var(--text-secondary); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem;">
                <span>Всего файлов: @files.Count</span>
                <span>Активных: @files.Count(f => !f.IsDeleted) | Удалённых: @files.Count(f => f.IsDeleted)</span>
            </div>
        }
    </section>
}

@code {
    private SyncProfile? activeProfile;
    private bool isLoadingProfile = true;
    private bool isLoadingFiles = false;
    private bool includeDeleted = true;
    private string? errorMessage;
    private List<FileMetadataDto> files = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            activeProfile = await ProfileService.GetProfileAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка получения профиля синхронизации");
            errorMessage = "Ошибка обмена с сервером при получении профиля.";
        }
        finally
        {
            isLoadingProfile = false;
        }

        if (activeProfile != null)
        {
            await LoadFilesAsync();
        }
    }

    private async Task LoadFilesAsync()
    {
        if (activeProfile == null) return;

        isLoadingFiles = true;
        errorMessage = null;

        try
        {
            var response = await BackupService.GetFilesAsync(activeProfile.BackupSetId, includeDeleted);
            if (response.Success && response.Files != null)
            {
                files = response.Files.OrderBy(f => f.RelativePath).ToList();
            }
            else
            {
                errorMessage = response.ErrorMessage ?? "Не удалось загрузить список файлов.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки списка файлов");
            errorMessage = "Ошибка обмена с сервером при загрузке файлов. Подробности записаны в журнал.";
        }
        finally
        {
            isLoadingFiles = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "Б", "КБ", "МБ", "ГБ" };
        double size = bytes;
        int unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }
        return $"{size:0.##} {units[unitIndex]}";
    }
}
