@inherits LayoutComponentBase

<div style="width: 100%; max-width: 920px; display: flex; flex-direction: column; gap: 1.5rem; margin: 0 auto;">
    <nav class="system-nav">
        <a href="" class="nav-brand">🛡️ Система резервного копирования v1.1</a>
        <div class="nav-links">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link">Главная</NavLink>
            <NavLink href="files" class="nav-link">Файлы и версии</NavLink>
            <NavLink href="history" class="nav-link">Журнал изменений</NavLink>
        </div>
    </nav>

    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>
