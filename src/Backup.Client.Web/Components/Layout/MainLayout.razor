@inherits LayoutComponentBase

<div style="width: 100%; max-width: 920px; display: flex; flex-direction: column; gap: 1.5rem; margin: 0 auto;">
    <nav class="system-nav">
        <a href="" class="nav-brand">🛡️ Backup System v1.1</a>
        <div class="nav-links">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link">Dashboard</NavLink>
            <NavLink href="files" class="nav-link">Files &amp; Versions</NavLink>
            <NavLink href="history" class="nav-link">Change Log</NavLink>
        </div>
    </nav>

    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
